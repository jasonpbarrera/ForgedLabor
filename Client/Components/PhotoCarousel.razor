@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Photos.Count > 0)
{
    <div class="forged-carousel">

        <!-- Main Viewport -->
        <div class="forged-carousel-viewport">
            <div class="forged-carousel-track" style="transform: translateX(-@(currentIndex * 100)%);">
                @foreach (var photo in Photos)
                {
                    <div class="forged-carousel-slide">
                        <div class="forged-carousel-img-wrap" @onclick="OpenLightbox" title="Click to view full size">
                            <img src="@photo.Src"
                                 alt="@photo.Alt"
                                 loading="lazy" />
                            <span class="forged-carousel-zoom-hint">&#x26F6; FULL SIZE</span>
                        </div>
                        <div class="forged-carousel-caption">
                            <div class="forged-carousel-title">@photo.Title</div>
                            <p class="forged-carousel-desc">@photo.Caption</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Prev / Next Buttons -->
            @if (Photos.Count > 1)
            {
                <button type="button" class="forged-carousel-arrow prev" @onclick="Prev" aria-label="Previous photo">
                    &#10094;
                </button>
                <button type="button" class="forged-carousel-arrow next" @onclick="Next" aria-label="Next photo">
                    &#10095;
                </button>

                <!-- Top-Right Counter & Pause/Play -->
                <div class="forged-carousel-hud">
                    <span class="forged-carousel-counter">@(currentIndex + 1) / @Photos.Count</span>
                    <button type="button" class="forged-carousel-toggle" @onclick="TogglePause" title="@(isPaused ? "Resume auto-scroll" : "Pause auto-scroll")">
                        @(isPaused ? "▶ PLAY" : "❚❚ PAUSE")
                    </button>
                </div>
            }
        </div>

        <!-- Scrollable Thumbnail Strip -->
        @if (Photos.Count > 1)
        {
            <div class="forged-carousel-thumbs" role="tablist" aria-label="Gallery thumbnails">
                @for (int i = 0; i < Photos.Count; i++)
                {
                    var idx = i;
                    var thumb = Photos[idx];
                    <button type="button"
                            class="forged-carousel-thumb @(idx == currentIndex ? "active" : "")"
                            @onclick="() => Select(idx)"
                            aria-label="View @thumb.Title">
                        <img src="@thumb.Src" alt="@thumb.Alt" loading="lazy" style="object-position: @thumb.ObjectPosition;" />
                    </button>
                }
            </div>
        }
    </div>
}

<!-- Full-Size Lightbox Modal -->
@if (isLightboxOpen && Photos.Count > 0)
{
    var active = Photos[currentIndex];
    <div class="forged-lightbox-backdrop" @ref="lightboxRef" tabindex="-1" @onclick="CloseLightbox" role="dialog" aria-modal="true" aria-label="@active.Title">
        <div class="forged-lightbox-shell" @onclick:stopPropagation="true">
            <button type="button" class="forged-lightbox-close" @onclick="CloseLightbox" aria-label="Close full-size image">
                &#10005; CLOSE
            </button>

            <div class="forged-lightbox-media">
                @if (Photos.Count > 1)
                {
                    <button type="button" class="forged-lightbox-arrow prev" @onclick="Prev" aria-label="Previous photo">
                        &#10094;
                    </button>
                }

                <img src="@active.Src" alt="@active.Alt" />

                @if (Photos.Count > 1)
                {
                    <button type="button" class="forged-lightbox-arrow next" @onclick="Next" aria-label="Next photo">
                        &#10095;
                    </button>
                }
            </div>

            <div class="forged-lightbox-footer">
                <div>
                    <div class="forged-lightbox-title">@active.Title</div>
                    <p class="forged-lightbox-desc">@active.Caption</p>
                </div>
                <span class="forged-lightbox-count">@(currentIndex + 1) / @Photos.Count</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<GalleryPhoto> Photos { get; set; } = new();
    [Parameter] public int IntervalMs { get; set; } = 3500;

    private int currentIndex = 0;
    private bool isPaused = false;
    private bool isLightboxOpen = false;
    private bool shouldFocusLightbox = false;
    private ElementReference lightboxRef;
    private System.Threading.Timer? autoTimer;
    private bool isDisposed = false;

    private IJSObjectReference? jsModule;
    private IJSObjectReference? jsKeyHandle;
    private DotNetObjectReference<PhotoCarousel>? dotNetRef;

    protected override void OnParametersSet()
    {
        if (currentIndex >= Photos.Count)
        {
            currentIndex = 0;
        }
        SyncTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotNetRef = DotNetObjectReference.Create(this);
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/PhotoCarousel.razor.js");
                jsKeyHandle = await jsModule.InvokeAsync<IJSObjectReference>("registerKeyHandler", dotNetRef);
            }
            catch
            {
                // Ignore JS interop failures during prerender/teardown
            }
        }

        if (shouldFocusLightbox && isLightboxOpen)
        {
            shouldFocusLightbox = false;
            try
            {
                await lightboxRef.FocusAsync();
            }
            catch
            {
                // Ignore focus errors if element is not yet mounted
            }
        }
    }

    [JSInvokable]
    public void OnWindowKeyDown(string key)
    {
        if (!isLightboxOpen || isDisposed) return;

        if (key == "Escape")
        {
            CloseLightbox();
            StateHasChanged();
        }
        else if (key == "ArrowRight")
        {
            Next();
            StateHasChanged();
        }
        else if (key == "ArrowLeft")
        {
            Prev();
            StateHasChanged();
        }
    }

    private void SyncTimer()
    {
        if (isDisposed) return;

        autoTimer?.Dispose();
        autoTimer = null;

        if (Photos.Count > 1 && IntervalMs > 0 && !isPaused && !isLightboxOpen)
        {
            autoTimer = new System.Threading.Timer(_ =>
            {
                if (isDisposed || isPaused || isLightboxOpen || Photos.Count <= 1) return;
                _ = InvokeAsync(() =>
                {
                    if (isDisposed || isPaused || isLightboxOpen || Photos.Count <= 1) return;
                    currentIndex = (currentIndex + 1) % Photos.Count;
                    StateHasChanged();
                });
            }, null, IntervalMs, IntervalMs);
        }
    }

    private void OpenLightbox()
    {
        isLightboxOpen = true;
        shouldFocusLightbox = true;
        SyncTimer();
    }

    private void CloseLightbox()
    {
        isLightboxOpen = false;
        shouldFocusLightbox = false;
        SyncTimer();
    }

    private void Next()
    {
        if (Photos.Count == 0) return;
        currentIndex = (currentIndex + 1) % Photos.Count;
        SyncTimer();
    }

    private void Prev()
    {
        if (Photos.Count == 0) return;
        currentIndex = (currentIndex - 1 + Photos.Count) % Photos.Count;
        SyncTimer();
    }

    private void Select(int idx)
    {
        currentIndex = idx;
        SyncTimer();
    }

    private void TogglePause()
    {
        isPaused = !isPaused;
        SyncTimer();
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        autoTimer?.Dispose();
        autoTimer = null;

        if (jsKeyHandle is not null)
        {
            try
            {
                await jsKeyHandle.InvokeVoidAsync("dispose");
                await jsKeyHandle.DisposeAsync();
            }
            catch { }
        }

        if (jsModule is not null)
        {
            try
            {
                await jsModule.DisposeAsync();
            }
            catch { }
        }

        dotNetRef?.Dispose();
    }
}
