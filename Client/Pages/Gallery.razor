@page "/gallery"
@page "/behind-the-scenes"
@inject IOptions<BusinessSettings> BusinessConfig

<PageTitle>Behind The Scenes | Forged Labor</PageTitle>

<!-- =========================================
     SUBPAGE HERO: CLEAN SOLID BLACK [NO DUPLICATE BACKGROUND IMAGE]
     ========================================= -->
<section class="sec-subpage-header">
    <div class="container-wide">
        <div class="subpage-header-content">
            <h1 class="subpage-heading">
                BEHIND THE <span class="text-gold">SCENES</span>
            </h1>
            <h4 class="subpage-subheading">
                REAL MOVES. REAL SWEAT. REAL DISCIPLINE.
            </h4>
            <p class="subpage-lead">
                Take a look at how Ben and the crew operate: tight wall-to-wall truck packs, heavy fitness equipment rigging, and the positive energy that keeps our momentum high on every move.
            </p>
            <div style="margin-top: 1.5rem;">
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-pill-yellow">
                    CALL NOW
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Continuous Scrolling Marquee (Exact Squarespace Animation) -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <span class="marquee-item">WALL-TO-WALL PACKS - HEAVY LIFTS - CREW CAMARADERIE - REAL SWEAT - CLEVELAND TN - &nbsp;</span>
        <span class="marquee-item">WALL-TO-WALL PACKS - HEAVY LIFTS - CREW CAMARADERIE - REAL SWEAT - CLEVELAND TN - &nbsp;</span>
        <span class="marquee-item">WALL-TO-WALL PACKS - HEAVY LIFTS - CREW CAMARADERIE - REAL SWEAT - CLEVELAND TN - &nbsp;</span>
        <span class="marquee-item">WALL-TO-WALL PACKS - HEAVY LIFTS - CREW CAMARADERIE - REAL SWEAT - CLEVELAND TN - &nbsp;</span>
    </div>
</div>

<!-- =========================================
     SECTION 2: THE ART OF THE LOAD [DARK-BOLD #383838 GRAY]
     Columns: LEFT = Truck Pack Photo | RIGHT = Copy
     ========================================= -->
<section class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col sec2-mobile-reverse">
            <!-- Left Column: Loaded Truck Photo -->
            <div class="sec2-img-col">
                <img src="images/local-movers-cleveland-tn.jpg" alt="Local Movers Cleveland TN - Packed Truck Bed" class="sqsp-clean-img" />
            </div>

            <!-- Right Column: Heading & Copy -->
            <div class="sec2-text-col">
                <h2 style="font-size: clamp(2.2rem, 3.8vw, 3rem); color: #ffffff; margin-bottom: 1.5rem; text-transform: lowercase;">
                    the art of the load.
                </h2>
                
                <p style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.65;">
                    Zero dead space. Heavy items locked on the deck. Uniform box tiers strapped and stacked securely to the ceiling so nothing shifts on Tennessee roads.
                </p>

                <p style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.6;">
                    Anyone can toss boxes into a truck bed. <strong>FORGED LABOR</strong> builds architectural cargo walls that protect your furniture and maximize every single cubic foot of space.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    Every dresser is blanket-wrapped with heavy commercial pads, strapped with tension, and buffered against friction. When the roll-up door opens at your destination, everything is sitting exactly where it was placed.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; line-height: 1.65;">
                    No crushed boxes. No scratched table legs. <strong>Precision packing every time.</strong>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 3: PHOTO SHOWCASE [WHITE SECTION]
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 4.5vw, 3.6rem); color: var(--brand-accent); text-transform: uppercase; margin-bottom: 0.35rem; font-family: var(--font-heading); letter-spacing: -0.01em;">
            FORGED LABOR
        </h2>
        <h4 style="font-size: 1.15rem; color: #000000; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 2rem; font-family: var(--font-heading); font-weight: 900;">
            FIELD OPERATIONS &amp; CREW MOMENTS
        </h4>

        <div class="grid-2col" style="gap: 2.5rem; align-items: start;">
            <!-- Card 1: Team Photo -->
            <div class="accordion-box" style="padding: 1.5rem;">
                <img src="images/team.jpg" alt="Forged Labor Crew" class="sqsp-clean-img" style="margin-bottom: 1.25rem;" />
                <h3 style="font-family: var(--font-heading); color: #000000; font-size: 1.25rem; text-transform: uppercase; margin-bottom: 0.5rem;">
                    PRE-MOVE CREW BRIEFING
                </h3>
                <p style="color: #222222; font-size: 0.95rem; line-height: 1.6; margin: 0;">
                    Ben and the crew reviewing entry routes, doorframe clearances, and loading sequences before beginning physical work.
                </p>
            </div>

            <!-- Card 2: Mover Photo -->
            <div class="accordion-box" style="padding: 1.5rem;">
                <img src="images/forged-labor-moving-services.jpg" alt="Forged Labor Moving Services" class="sqsp-clean-img" style="margin-bottom: 1.25rem;" />
                <h3 style="font-family: var(--font-heading); color: #000000; font-size: 1.25rem; text-transform: uppercase; margin-bottom: 0.5rem;">
                    DISCIPLINED MOMENTUM
                </h3>
                <p style="color: #222222; font-size: 0.95rem; line-height: 1.6; margin: 0;">
                    Maintaining steady, athletic movement throughout the move. Proper lifting mechanics and continuous care from start to finish.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 4: CHEVRON DIVIDER [BLACK THEME]
     ========================================= -->
<section class="sec-move-people">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 6vw, 4.8rem); color: var(--brand-accent); text-transform: uppercase; margin: 0; letter-spacing: -0.02em; font-family: var(--font-heading);">
            REAL WORK. REAL SWEAT.
        </h2>
    </div>
</section>

<!-- =========================================
     SECTION 5: CLIENT COMMUNITY [TENNESSEE GOLD #EFB600]
     ========================================= -->
<section class="sec-gold-reviews">
    <div class="container-wide">
        <h2 class="sec-reviews-heading">
            TAG US ON YOUR MOVING DAY
        </h2>

        <div class="reviews-grid">
            <div class="review-card-wrapper">
                <div class="review-stars">📸</div>
                <h4 style="font-family: var(--font-heading); color: #000000; font-size: 1.15rem; margin-bottom: 0.5rem; text-transform: uppercase;">
                    INSTAGRAM COMMUNITY
                </h4>
                <p class="review-text">
                    Follow and tag @@forgedlabor in your moving day photos! We love sharing our clients settling into their new homes across Tennessee.
                </p>
                <div class="review-author" style="margin-top: 1rem;">
                    <a href="https://www.instagram.com/forgedlabor" target="_blank" rel="noopener" style="color: #000000; font-weight: 900; text-decoration: underline;">
                        FOLLOW @@FORGEDLABOR →
                    </a>
                </div>
            </div>

            <div class="review-card-wrapper">
                <div class="review-stars">👍</div>
                <h4 style="font-family: var(--font-heading); color: #000000; font-size: 1.15rem; margin-bottom: 0.5rem; text-transform: uppercase;">
                    FACEBOOK PAGE
                </h4>
                <p class="review-text">
                    Check out recent project highlights, community updates, and seasonal crew milestones on our official Facebook page.
                </p>
                <div class="review-author" style="margin-top: 1rem;">
                    <a href="https://www.facebook.com/Forgedlabor" target="_blank" rel="noopener" style="color: #000000; font-weight: 900; text-decoration: underline;">
                        VISIT OUR FACEBOOK →
                    </a>
                </div>
            </div>

            <div class="review-card-wrapper">
                <div class="review-stars">⭐</div>
                <h4 style="font-family: var(--font-heading); color: #000000; font-size: 1.15rem; margin-bottom: 0.5rem; text-transform: uppercase;">
                    SHARE A REVIEW
                </h4>
                <p class="review-text">
                    Had a great experience with Ben and the crew? Your review helps other Cleveland and Chattanooga homeowners find reliable movers.
                </p>
                <div class="review-author" style="margin-top: 1rem;">
                    <a href="https://maps.app.goo.gl/FkAPVz7Y3y5YTgL2A" target="_blank" rel="noopener" style="color: #000000; font-weight: 900; text-decoration: underline;">
                        LEAVE A GOOGLE REVIEW →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 6: CTA TO BOOK [DARK-BOLD #383838 GRAY]
     ========================================= -->
<section class="sec-dark-bold" style="text-align: center; padding: clamp(4rem, 6vw, 6rem) 0;">
    <div class="container-wide" style="max-width: 800px; margin: 0 auto;">
        <h2 style="font-size: clamp(2.2rem, 4vw, 3.2rem); color: #ffffff; text-transform: uppercase; margin-bottom: 1.25rem;">
            NEED A CREW LIKE THIS FOR YOUR MOVE?
        </h2>
        <p style="font-size: 1.1rem; color: #d4d4d8; line-height: 1.6; margin-bottom: 2.5rem;">
            Schedule with Ben directly or call to lock in your date on our calendar.
        </p>
        <div style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap;">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-pill-yellow">
                CALL BEN NOW (423) 715-4254
            </a>
            <a href="/appointments" class="sqsp-btn-outline" style="border-radius: 9999px;">
                OPEN LIVE SCHEDULER →
            </a>
        </div>
    </div>
</section>
