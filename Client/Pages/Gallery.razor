@page "/gallery"
@page "/behind-the-scenes"
@inject IOptions<BusinessSettings> BusinessConfig

<PageTitle>Behind the Scenes &amp; Job Gallery | @BusinessConfig.Value.ShortName</PageTitle>

<!-- Hero Section -->
<section class="sec-gallery-hero">
    <div class="container-wide">
        <div class="gallery-hero-content">
            <span class="badge-pill-accent">
                📸 The Forged Labor Experience
            </span>
            <h1 class="hero-heading" style="margin-top: 1rem; margin-bottom: 1.25rem;">
                BEHIND THE SCENES &amp; <span class="text-gold">JOB GALLERY</span>
            </h1>
            <p class="hero-tagline" style="max-width: 720px; font-size: 1.15rem; color: #d4d4d8; line-height: 1.6;">
                Real moves. Real sweat. Real precision. Take a look at how Ben and the crew operate: tight wall-to-wall truck packs, heavy fitness equipment rigging, and the camaraderie that keeps our energy high on every move.
            </p>
        </div>
    </div>
</section>

<!-- Filter Navigation -->
<section style="background: #121214; padding: 2rem 0; border-bottom: 1px solid #27272a; position: sticky; top: 78px; z-index: 90;">
    <div class="container-wide">
        <div class="gallery-filter-bar">
            <button class="gallery-filter-btn @(currentFilter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
                ALL PHOTOS (@items.Count)
            </button>
            <button class="gallery-filter-btn @(currentFilter == "truck-packs" ? "active" : "")" @onclick='() => SetFilter("truck-packs")'>
                🚚 TRUCK PACKS
            </button>
            <button class="gallery-filter-btn @(currentFilter == "fitness" ? "active" : "")" @onclick='() => SetFilter("fitness")'>
                🏋️‍♂️ FITNESS &amp; RIGGING
            </button>
            <button class="gallery-filter-btn @(currentFilter == "crew" ? "active" : "")" @onclick='() => SetFilter("crew")'>
                💪 CREW IN ACTION
            </button>
            <button class="gallery-filter-btn @(currentFilter == "bts" ? "active" : "")" @onclick='() => SetFilter("bts")'>
                📸 BEHIND THE SCENES
            </button>
        </div>
    </div>
</section>

<!-- Gallery Grid Section -->
<section style="background: #000000; padding: clamp(3rem, 5vw, 5rem) 0;">
    <div class="container-wide">
        <div class="gallery-grid">
            @foreach (var item in FilteredItems)
            {
                <div class="gallery-card">
                    <div class="gallery-card-img-wrapper">
                        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" class="gallery-card-img" />
                        <span class="gallery-category-badge">@item.CategoryBadge</span>
                    </div>
                    <div class="gallery-card-body">
                        <h3 class="gallery-card-title">@item.Title</h3>
                        <p class="gallery-card-desc">@item.Description</p>
                        <div class="gallery-card-footer">
                            <span class="gallery-tag">📍 @item.Location</span>
                            <span class="gallery-tag">⚡ @item.Highlight</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Submit Photos / Call to action -->
        <div class="gallery-cta-box">
            <div style="max-width: 700px; margin: 0 auto; text-align: center;">
                <span style="color: var(--brand-accent); font-family: var(--font-heading); font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase;">
                    Client Community
                </span>
                <h2 style="color: #ffffff; font-size: clamp(1.75rem, 3vw, 2.35rem); text-transform: uppercase; margin: 0.75rem 0 1rem;">
                    HAVE PHOTOS FROM YOUR MOVE WITH FORGED LABOR?
                </h2>
                <p style="color: #a1a1aa; font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
                    We love seeing our customers settling into their new homes and facilities. Tag us on Instagram <a href="https://www.instagram.com/forgedlabor" target="_blank" rel="noopener" style="color: var(--brand-accent); font-weight: 700;">@@forgedlabor</a> or Facebook to be featured in our monthly crew showcase!
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="/appointments" class="sqsp-btn-pill-yellow">
                        BOOK YOUR MOVE TODAY
                    </a>
                    <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-outline" style="border-radius: 9999px;">
                        CALL BEN (423) 715-4254
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string currentFilter = "all";

    private void SetFilter(string filter)
    {
        currentFilter = filter;
    }

    private IEnumerable<GalleryItem> FilteredItems =>
        currentFilter == "all" ? items : items.Where(x => x.Category == currentFilter);

