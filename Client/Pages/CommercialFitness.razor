@page "/commercial"
@page "/fitness-equipment-installation"
@inject IOptions<BusinessSettings> BusinessConfig
@inject HttpClient Http

<PageTitle>Commercial Moving & Fitness Equipment Installation | @BusinessConfig.Value.ShortName</PageTitle>

<!-- Hero Section -->
<section class="sec-commercial-hero">
    <div class="container-wide">
        <div class="commercial-hero-content">
            <span class="badge-pill-accent">
                ⚡ Specialized Commercial & B2B Solutions
            </span>
            <h1 class="hero-heading" style="margin-top: 1rem; margin-bottom: 1.25rem;">
                COMMERCIAL MOVING &amp; <span class="text-gold">FITNESS EQUIPMENT</span> INSTALLATION
            </h1>
            <p class="hero-tagline" style="max-width: 720px; font-size: 1.15rem; color: #d4d4d8; line-height: 1.6;">
                Precision teardown, rigging, transport, and reassembly for commercial gyms, corporate wellness centers, crossfit boxes, universities, and heavy commercial facilities throughout Cleveland, Chattanooga, and Southeast Tennessee.
            </p>
            <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="#commercial-quote" class="sqsp-btn-pill-yellow">
                    REQUEST COMMERCIAL QUOTE
                </a>
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-outline" style="border-radius: 9999px;">
                    CALL (423) 715-4254
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Why Forged Labor Niche Section -->
<section style="background: #121214; padding: clamp(4rem, 6vw, 6rem) 0; border-bottom: 1px solid #27272a;">
    <div class="container-wide">
        <div style="text-align: center; max-width: 820px; margin: 0 auto 3.5rem;">
            <span style="color: var(--brand-accent); font-family: var(--font-heading); font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 0.5rem;">
                Why We Specialize In Fitness & Heavy Commercial
            </span>
            <h2 style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: #ffffff; text-transform: uppercase;">
                MOST MOVERS DREAD GYM GEAR.<br /><span class="text-gold">WE THRIVE ON IT.</span>
            </h2>
            <p style="color: #a1a1aa; font-size: 1.05rem; margin-top: 1rem; line-height: 1.6;">
                Commercial fitness machinery isn't regular furniture. It requires mechanical know-how, cable pulley routing knowledge, structural torque specs, and extreme physical conditioning. Because our crew trains consistently, we understand how gym equipment functions, how it disassembles safely, and how to protect both the machine and your facility floors.
            </p>
        </div>

        <!-- 4 Core Commercial Pillars -->
        <div class="commercial-grid">
            <div class="commercial-card">
                <div class="commercial-card-icon">🏋️‍♂️</div>
                <h3 class="commercial-card-title">Commercial Gym Assembly &amp; Rigging</h3>
                <p class="commercial-card-desc">
                    Complete assembly and disassembly of power racks, multi-stack cable crossover machines, Smith machines, functional trainers, and selectorized weight stacks with precision cable tensioning.
                </p>
            </div>

            <div class="commercial-card">
                <div class="commercial-card-icon">⚡</div>
                <h3 class="commercial-card-title">Heavy Cardio &amp; Specialty Transport</h3>
                <p class="commercial-card-desc">
                    Careful handling of high-value commercial treadmills, curved manual runners, stairmasters, assault bikes, rowers, and plate-loaded leg presses utilizing specialized heavy-duty dollies and ramps.
                </p>
            </div>

            <div class="commercial-card">
                <div class="commercial-card-icon">🏢</div>
                <h3 class="commercial-card-title">Facility Moves &amp; Floor Reconfigurations</h3>
                <p class="commercial-card-desc">
                    Expanding your studio, relocating to a larger commercial space, or rearranging your layout? We provide rapid turnaround with minimal disruption to your members and training schedule.
                </p>
            </div>

            <div class="commercial-card">
                <div class="commercial-card-icon">🛡️</div>
                <h3 class="commercial-card-title">Facility Protection &amp; Full Insurance</h3>
                <p class="commercial-card-desc">
                    We lay heavy neoprene runners and floor protection to safeguard commercial rubber flooring, tile, and hardwood. Fully covered with commercial liability and cargo insurance.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Scope & Capabilities Breakdown -->
<section style="background: #000000; padding: clamp(4rem, 6vw, 6rem) 0; border-bottom: 2px solid var(--brand-accent);">
    <div class="container-wide">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center;">
            <div>
                <span style="color: var(--brand-accent); font-family: var(--font-heading); font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 0.5rem;">
                    Who We Serve
                </span>
                <h2 style="font-size: clamp(1.85rem, 3vw, 2.5rem); color: #ffffff; text-transform: uppercase; margin-bottom: 1.5rem;">
                    TRUSTED BY COMMERCIAL CLIENTS &amp; HOME ATHLETES
                </h2>

                <ul class="commercial-checklist">
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Commercial Gyms &amp; CrossFit Affiliates</strong>
                            <p>Full facility relocations, rig teardowns, and heavy dumbbell / barbell / bumper plate relocations.</p>
                        </div>
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Apartment &amp; HOA Fitness Centers</strong>
                            <p>Delivery, unloading, and precision assembly of newly purchased clubhouse fitness gear.</p>
                        </div>
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Corporate Wellness Rooms &amp; Universities</strong>
                            <p>Scheduled installations with strict adherence to building rules, freight elevator booking, and loading dock coordination.</p>
                        </div>
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Elite Residential Home Gyms</strong>
                            <p>Basement and garage gym setups: heavy dumbbell racks, power cages, and uncrating oversized equipment.</p>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Side Card with image / quote -->
            <div style="background: #18181b; border: 2px solid #27272a; border-radius: 12px; padding: 2.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <div style="display: inline-block; background: var(--brand-accent); color: #000000; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 900; padding: 0.35rem 0.85rem; border-radius: 4px; margin-bottom: 1.25rem;">
                    THE FORGED PROMISE
                </div>
                <h3 style="font-size: 1.5rem; color: #ffffff; margin-bottom: 1rem; text-transform: uppercase;">
                    "ZERO RUSTY THINKING. ZERO BROKEN CABLES."
                </h3>
                <p style="color: #a1a1aa; font-size: 1rem; line-height: 1.6; margin-bottom: 1.5rem;">
                    Every bolt is bagged and labeled by station. Every cable is detensioned cleanly and pinned. When we bolt your rig or functional trainer down in its new home, it is square, level, and ready for PRs on day one.
                </p>
                <div style="border-top: 1px solid #27272a; padding-top: 1.25rem; display: flex; align-items: center; gap: 1rem;">
                    <div style="width: 48px; height: 48px; background: var(--brand-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); color: #000000; font-weight: 900; font-size: 1.2rem;">
                        BW
                    </div>
                    <div>
                        <strong style="color: #ffffff; display: block; font-size: 1rem;">Ben Wiseman</strong>
                        <span style="color: #a1a1aa; font-size: 0.85rem;">Founder, Forged Labor</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Commercial Quote Intake Form Section -->
<section id="commercial-quote" style="background: #121214; padding: clamp(4rem, 6vw, 6rem) 0;">
    <div class="container-wide">
        <div style="max-width: 800px; margin: 0 auto; background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: clamp(2rem, 4vw, 3.5rem); box-shadow: 0 15px 35px rgba(0,0,0,0.4);">
            <div style="text-align: center; margin-bottom: 2.5rem;">
                <span style="color: var(--brand-accent); font-family: var(--font-heading); font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase;">
                    Fast B2B Turnaround
                </span>
                <h2 style="font-size: clamp(1.85rem, 3vw, 2.4rem); color: #ffffff; text-transform: uppercase; margin-top: 0.5rem;">
                    REQUEST A COMMERCIAL PROJECT QUOTE
                </h2>
                <p style="color: #a1a1aa; font-size: 0.95rem; margin-top: 0.5rem;">
                    Fill out the details below and Ben Wiseman will contact you directly within 24 hours to schedule a walk-through or provide a formal estimate.
                </p>
            </div>

            @if (isSubmitted)
            {
                <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #4ade80; padding: 2rem; border-radius: 8px; text-align: center;">
                    <h3 style="margin-top: 0; font-size: 1.5rem; font-weight: 800;">✓ Commercial Request Received!</h3>
                    <p style="color: #d1fae5; font-size: 1rem; margin: 1rem 0 1.5rem; line-height: 1.6;">
                        Thank you, @contactName! Your commercial inquiry has been sent directly to Ben Wiseman. We will review your equipment specs and follow up shortly.
                    </p>
                    <button @onclick="ResetForm" class="sqsp-btn-pill-yellow" style="padding: 0.75rem 2rem; font-size: 0.9rem;">
                        Submit Another Request
                    </button>
                </div>
            }
            else
            {
                <form @onsubmit="SubmitCommercialLead" @onsubmit:preventDefault>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-size: 0.95rem;">
                            @errorMessage
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
                        <div>
                            <label class="form-label">Contact Person *</label>
                            <input type="text" class="form-input" @bind="contactName" required placeholder="Ben Smith" />
                        </div>
                        <div>
                            <label class="form-label">Business / Facility Name *</label>
                            <input type="text" class="form-input" @bind="businessName" required placeholder="Anytime Fitness / Iron Works Gym" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
                        <div>
                            <label class="form-label">Direct Phone *</label>
                            <input type="tel" class="form-input" @bind="phone" required placeholder="(423) 555-0199" />
                        </div>
                        <div>
                            <label class="form-label">Email Address *</label>
                            <input type="email" class="form-input" @bind="email" required placeholder="manager@gym.com" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
                        <div>
                            <label class="form-label">Project Type *</label>
                            <select class="form-input" @bind="projectType">
                                <option value="Commercial Gym Equipment Assembly">Commercial Gym Equipment Assembly</option>
                                <option value="Gym Relocation & Rigging">Gym Relocation &amp; Rigging</option>
                                <option value="Heavy Equipment Transport">Heavy Equipment Transport</option>
                                <option value="Residential Elite Home Gym Setup">Residential Elite Home Gym Setup</option>
                                <option value="Commercial Office Relocation">Commercial Office Relocation</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Target Date (Optional)</label>
                            <input type="date" class="form-input" @bind="targetDate" />
                        </div>
                    </div>

                    <div style="margin-bottom: 1.25rem;">
                        <label class="form-label">Facility Details &amp; Equipment List *</label>
                        <textarea class="form-input" rows="4" @bind="equipmentDetails" required placeholder="Please list equipment (e.g., 2 Power Cages, 1 Cable Crossover, 4 Treadmills), pickup & delivery locations, loading dock or stair access details..."></textarea>
                    </div>

                    <!-- Honeypot -->
                    <div style="display:none;" aria-hidden="true">
                        <input type="text" @bind="botHoneypot" tabindex="-1" autocomplete="off" />
                    </div>

                    <button type="submit" class="sqsp-btn-pill-yellow" style="width: 100%; padding: 1.15rem; font-size: 1.05rem;" disabled="@isSubmitting">
                        @(isSubmitting ? "TRANSMITTING TO BEN..." : "SUBMIT COMMERCIAL INQUIRY")
                    </button>
                    
                    <p style="text-align: center; color: #71717a; font-size: 0.85rem; margin-top: 1rem;">
                        Prefer to talk immediately? Call Ben directly at <a href="tel:@BusinessConfig.Value.PhoneNumber" style="color: var(--brand-accent); font-weight: 700;">@BusinessConfig.Value.PhoneNumber</a>
                    </p>
                </form>
            }
        </div>
    </div>
</section>

@code {
    private string contactName = string.Empty;
    private string businessName = string.Empty;
    private string phone = string.Empty;
    private string email = string.Empty;
    private string projectType = "Commercial Gym Equipment Assembly";
    private DateTime? targetDate;
    private string equipmentDetails = string.Empty;
    private string botHoneypot = string.Empty;

    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private string? errorMessage;

    private async Task SubmitCommercialLead()
    {
        if (!string.IsNullOrEmpty(botHoneypot)) return;

        isSubmitting = true;
        errorMessage = null;

        var fullMessage = $"[Commercial Lead - {businessName}]\nContact: {contactName}\nProject: {projectType}\nTarget Date: {targetDate?.ToString("yyyy-MM-dd") ?? "Flexible"}\nDetails:\n{equipmentDetails}";

        var leadRequest = new LeadSubmissionRequest
        {
            BusinessId = "forged-labor",
            CompanyName = "Forged Labor",
            Name = $"{contactName} ({businessName})",
            Phone = phone,
            Email = email,
            PreferredContactMethod = "Phone Call",
            ServiceType = "Commercial & Fitness Equipment Installation",
            PreferredStartDate = targetDate?.ToString("yyyy-MM-dd"),
            Message = fullMessage,
            Honeypot = botHoneypot
        };

        try
        {
            var response = await Http.PostAsJsonAsync("/api/leads", leadRequest);
            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
            }
            else
            {
                errorMessage = "We could not submit your request at this time. Please call (423) 715-4254 directly.";
            }
        }
        catch (Exception)
        {
            errorMessage = "A connection error occurred. Please call (423) 715-4254 directly.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        contactName = string.Empty;
        businessName = string.Empty;
        phone = string.Empty;
        email = string.Empty;
        targetDate = null;
        equipmentDetails = string.Empty;
        botHoneypot = string.Empty;
        isSubmitted = false;
        errorMessage = null;
    }
}
