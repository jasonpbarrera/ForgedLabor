@page "/commercial"
@page "/fitness-equipment-installation"
@inject IOptions<BusinessSettings> BusinessConfig
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Commercial Fitness Equipment Installation &amp; Gym Setups | Forged Labor</PageTitle>
<HeadContent>
    <meta name="description" content="Professional commercial fitness equipment receiving, freight unloading, unboxing, assembly, installation, floor protection, leveling, and anchoring across Southeast TN, North GA, and AL." />
    <link rel="canonical" href="https://forgedlabor.com/commercial" />
</HeadContent>

<!-- =========================================
     SUBPAGE HERO: CLEAN SOLID BLACK [NO DUPLICATE BACKGROUND IMAGE]
     ========================================= -->
<section class="sec-subpage-header">
    <div class="container-wide">
        <div class="subpage-header-content">
            <div style="font-family: var(--font-heading); font-size: clamp(0.85rem, 1.4vw, 1rem); color: var(--brand-accent); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.9rem;">
                FORGED LABOR | COMMERCIAL SERVICES
            </div>
            <h1 class="subpage-heading">
                COMMERCIAL<br />
                FITNESS EQUIPMENT<br />
                <span class="text-gold">INSTALLATION &amp;<br />GYM SETUPS</span>
            </h1>
            <hr style="border: 0; border-top: 2px solid var(--brand-accent); max-width: 680px; margin: 1.5rem 0;" />
            <h4 class="subpage-subheading" style="color: #ffffff; margin-bottom: 0.85rem;">
                CLEVELAND, CHATTANOOGA &amp;<br />SOUTHEAST TENNESSEE &bull; REGIONAL TRAVEL AVAILABLE
            </h4>
            <p class="subpage-lead">
                Professional fitness equipment receiving, freight unloading, unboxing, assembly, installation, facility setup, and post-installation cleanup.
            </p>
            <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="#commercial-quote" class="sqsp-btn-pill-yellow">
                    REQUEST COMMERCIAL QUOTE
                </a>
                <a href="docs/forged-labor-commercial-capability-sheet.pdf" target="_blank" rel="noopener" class="sqsp-btn-outline" style="border-radius: 9999px;">
                    DOWNLOAD CAPABILITY SHEET (PDF)
                </a>
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-outline" style="border-radius: 9999px;">
                    CALL (423) 715-4254
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Continuous Scrolling Marquee (Exact Squarespace Animation) -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
    </div>
</div>

<!-- =========================================
     SECTION 2: WHY WE SPECIALIZE [DARK-BOLD #383838 GRAY]
     Columns: LEFT = Truck Pack / Rigging Photo | RIGHT = Copy
     ========================================= -->
<section class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col sec2-mobile-reverse">
            <!-- Left Column: Finished Commercial Gym Installation Photo -->
            <div class="sec2-img-col">
                <img src="images/gallery/fit-collegiate-racks.webp" alt="Finished Commercial Power Rack & Weight Room Installation by Forged Labor" class="sqsp-clean-img" />
            </div>

            <!-- Right Column: Copy -->
            <div class="sec2-text-col">
                <h2 style="font-size: clamp(2.2rem, 3.8vw, 3rem); color: #ffffff; margin-bottom: 1.5rem; text-transform: lowercase;">
                    most movers dread gym gear.
                </h2>
                
                <p style="font-size: 1.25rem; font-weight: 800; color: var(--brand-accent); margin-bottom: 1.25rem; text-transform: uppercase;">
                    WE THRIVE ON IT.
                </p>

                <p style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.65;">
                    Commercial fitness equipment installation requires more than physical strength. It demands patience, organization, attention to detail, and a crew that understands the importance of getting every step right.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    At Forged Labor, we're comfortable with the nuts and bolts. Our team takes a methodical approach to assembly, carefully organizing components, laying out hardware, maintaining clean workspaces, and keeping packaging materials and dunnage under control throughout the installation process.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    We understand the importance of working alongside experienced brand representatives and installation leads. Our crew listens, follows direction, communicates effectively, and provides dependable hands-on support to keep projects moving efficiently.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    From unloading and staging equipment to assisting with complex assemblies and final cleanup, we take pride in being the kind of crew that makes an installation lead's job easier.
                </p>

                <p style="font-size: 1.05rem; color: var(--brand-accent); font-style: italic; font-weight: 700; line-height: 1.65;">
                    Organized. Coachable. Detail-oriented. Ready to work.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 3: COMMERCIAL CAPABILITIES [WHITE SECTION]
     Columns: LEFT = Accordion Box | RIGHT = Clean Photo
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <div class="grid-2col sec3-mobile-flow">
            <!-- Left Column: Accordion Capabilities -->
            <div class="sec3-text-col">
                <h2 style="font-size: clamp(2.5rem, 4.5vw, 3.6rem); color: var(--brand-accent); text-transform: uppercase; margin-bottom: 0.35rem; font-family: var(--font-heading); letter-spacing: -0.01em;">
                    FORGED COMMERCIAL
                </h2>
                <h4 style="font-size: 1.15rem; color: #000000; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 2rem; font-family: var(--font-heading); font-weight: 900;">
                    SPECIALIZED RIGGING, INSTALLATION, OR TEARDOWN
                </h4>

                <div class="accordion-box">
                    <div class="accordion-item">
                        <div class="accordion-title">
                            FREIGHT RECEIVING, UNLOADING &amp; STAGING
                        </div>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            From the moment equipment arrives, our crew is ready to get to work. We assist with unloading freight trucks, receiving and organizing shipments, moving pallets and equipment into position, and carefully unboxing commercial fitness machinery.
                        </p>
                        <p class="accordion-desc">
                            We take a methodical approach to every installation, keeping components organized, hardware accounted for, and packaging materials and dunnage consolidated throughout the process. By maintaining a clean, efficient workspace from start to finish, we help installation leads and project managers keep operations running smoothly.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            COMMERCIAL FITNESS EQUIPMENT ASSEMBLY &amp; INSTALLATION
                        </div>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            From commercial treadmills, StairMasters, and rowers to power racks, Smith machines, functional trainers, cable crossover systems, and plate-loaded strength equipment, our crew provides dependable hands-on assembly and installation support.
                        </p>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            We understand that complex equipment requires patience, attention to detail, and effective teamwork. Whether working independently within our capabilities or alongside manufacturer representatives and installation leads, we follow instructions carefully, communicate clearly, and approach every assembly with precision.
                        </p>
                        <p class="accordion-desc">
                            <em>From the first bolt to the final cleanup, we're committed to getting the job done right.</em>
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            FACILITY RELOCATIONS &amp; RECONFIGURATIONS
                        </div>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            Expanding your studio, relocating to a larger commercial space, or rearranging your training floor? Forged Labor also provides commercial fitness equipment disassembly, transportation, storage transfers, and reassembly.
                        </p>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            Our crew carefully labels and bags hardware, keeps components associated with their respective machines, and organizes equipment for efficient transportation and reinstallation.
                        </p>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            Moving into storage? We'll help prepare and transport your equipment, and when your new facility is ready, our team can return to handle reassembly.
                        </p>
                        <p class="accordion-desc">
                            <em>Whether you're building a new gym or relocating an existing one, we're ready to help.</em>
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            FLOOR PROTECTION, PRECISION LEVELING &amp; ANCHORING
                        </div>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            Protecting your facility is just as important as installing the equipment inside it. Our crew takes care to prevent unnecessary damage to rubber flooring, turf, tile, and other finished surfaces throughout the installation process.
                        </p>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            When appropriate, we utilize plywood to protect vulnerable or high-traffic areas, carefully maneuver pallets and equipment, and avoid dragging heavy machinery across finished floors.
                        </p>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            We also understand the importance of proper leveling, hardware alignment, and secure assembly. Whether following the specifications of an installation lead or completing the assembly ourselves, we pay close attention to equipment positioning, bolt tightening, and final alignment.
                        </p>
                        <p class="accordion-desc" style="margin-bottom: 0.75rem;">
                            Where required and within the approved project scope, our team can also assist with concrete anchoring and equipment securing in accordance with manufacturer specifications.
                        </p>
                        <p class="accordion-desc">
                            <em>Every detail matters, from protecting the floor beneath the equipment to ensuring the installation is completed properly.</em>
                        </p>
                    </div>
                </div>

                <div style="margin-top: 2rem;">
                    <p style="font-size: 0.95rem; color: #333333; line-height: 1.6; margin: 0;">
                        Full commercial general liability and cargo insurance coverage on every project.
                    </p>
                </div>
            </div>

            <!-- Right Column: Team Photo -->
            <div class="sec3-img-col">
                <img src="images/commercial-crew.webp" alt="Forged Labor crew in safety vests after a commercial weight room equipment installation" class="sqsp-clean-img" width="1400" height="1050" loading="lazy" />
            </div>
        </div>

        <!-- Recent Commercial Fitness Installations Scrollable Carousel -->
        <div style="margin-top: 4rem;">
            <h2 style="font-size: clamp(2.1rem, 4vw, 3rem); color: var(--brand-accent); text-transform: uppercase; margin-bottom: 0.35rem; font-family: var(--font-heading); letter-spacing: -0.01em;">
                RECENT FITNESS INSTALLATIONS
            </h2>
            <h4 style="font-size: 1.05rem; color: #000000; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 2rem; font-family: var(--font-heading); font-weight: 900;">
                ATHLETIC WEIGHT ROOMS, RIGS &amp; HOME GYMS
            </h4>

            <PhotoCarousel Photos="@fitnessPhotos" IntervalMs="3500" />
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 4: CHEVRON DIVIDER [BLACK THEME]
     ========================================= -->
<section class="sec-move-people">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 6vw, 4.8rem); color: var(--brand-accent); text-transform: uppercase; margin: 0; letter-spacing: -0.02em; font-family: var(--font-heading);">
            BUILT FOR THE HEAVY LIFTS.
        </h2>
    </div>
</section>

<!-- =========================================
     SECTION 4B: REGIONAL RADIUS, FACILITIES & COMMERCIAL FAQ [WHITE SECTION]
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <div class="grid-2col" style="margin-bottom: 3.5rem; align-items: start;">
            <div>
                <h2 style="font-size: clamp(2rem, 3.8vw, 2.8rem); color: var(--brand-accent); text-transform: uppercase; margin-bottom: 0.35rem; font-family: var(--font-heading);">
                    REGIONAL COVERAGE
                </h2>
                <h4 style="font-size: 1.05rem; color: #000000; text-transform: uppercase; margin-bottom: 1.25rem; font-family: var(--font-heading); font-weight: 900;">
                    SOUTHEAST TENNESSEE, NORTH GEORGIA &amp; ALABAMA
                </h4>
                <p style="font-size: 1rem; color: #222222; line-height: 1.65; margin-bottom: 1rem;">
                    Headquartered in <strong>Cleveland, TN</strong> right off I-75, our crew provides daily commercial coverage across Cleveland, Chattanooga, Ooltewah, Athens, and Knoxville—and travels regionally across <strong>Tennessee, North Georgia, Alabama, and the Southeast</strong> for multi-day commercial builds.
                </p>
                <p style="font-size: 1rem; color: #222222; line-height: 1.65; margin-bottom: 1.5rem;">
                    Need a 1-page overview for your project manager or equipment dealer? Download our commercial capability statement with insurance details, crew specs, and direct contact info.
                </p>
                <a href="docs/forged-labor-commercial-capability-sheet.pdf" target="_blank" rel="noopener" class="sqsp-btn-primary" style="background: #000000; color: var(--brand-accent); border-color: #000000;">
                    DOWNLOAD CAPABILITY SHEET (PDF) →
                </a>
            </div>

            <div class="accordion-box" style="padding: 1.75rem;">
                <h3 style="font-family: var(--font-heading); color: #000000; font-size: 1.2rem; text-transform: uppercase; margin-bottom: 1rem;">
                    FACILITIES &amp; EQUIPMENT WE OUTFIT
                </h3>
                <ul style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.75rem; color: #222222; font-size: 0.95rem; font-weight: 600;">
                    <li>&#9632; Collegiate &amp; High School Weight Rooms</li>
                    <li>&#9632; Commercial Gyms &amp; Performance Centers</li>
                    <li>&#9632; CrossFit &amp; Boutique Training Studios</li>
                    <li>&#9632; Apartment &amp; Multi-Family Fitness Centers</li>
                    <li>&#9632; Hotel, Corporate &amp; Rehab Gyms</li>
                    <li>&#9632; Private &amp; Elite Home Gyms</li>
                </ul>
                <p style="font-size: 0.9rem; color: #444444; margin: 1.25rem 0 0; line-height: 1.55;">
                    Experienced with multi-bay power racks, collegiate rigs, platforms, turf-mounted hardware, cable crossovers, Smith machines, plate-loaded strength lines, treadmills, StairMasters, rowers, and air bikes.
                </p>
            </div>
        </div>

        <h2 style="font-size: clamp(1.9rem, 3.5vw, 2.5rem); color: #000000; text-transform: uppercase; margin-bottom: 1.25rem; font-family: var(--font-heading);">
            COMMERCIAL INSTALLATION FAQ
        </h2>
        <div class="accordion-box">
            <div class="accordion-item">
                <div class="accordion-title">DO YOU WORK ALONGSIDE BRAND REPS &amp; INSTALLATION LEADS?</div>
                <p class="accordion-desc">Yes. We regularly work alongside manufacturer reps, project managers, and installation leads—following specs closely, organizing hardware, consolidating dunnage, and keeping multi-day installs on schedule.</p>
            </div>
            <div class="accordion-item">
                <div class="accordion-title">DO YOU CARRY COMMERCIAL INSURANCE &amp; PROVIDE A COI?</div>
                <p class="accordion-desc">Yes. Every commercial project is backed by Commercial General Liability and Cargo insurance coverage. Certificates of Insurance (COI) are available upon request.</p>
            </div>
            <div class="accordion-item">
                <div class="accordion-title">HOW DO YOU PROTECT RUBBER FLOORING, TURF &amp; FINISHED SURFACES?</div>
                <p class="accordion-desc">We lay plywood over vulnerable or high-traffic areas when appropriate, never drag heavy steel or machines across finished rubber, turf, or tile, and keep packaging and hardware consolidated throughout the build.</p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 5: COMMERCIAL INTAKE FORM [DARK-BOLD #383838 GRAY]
     (Matches Section 6 of Home Page Exactly)
     ========================================= -->
<section id="commercial-quote" class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col">
            <!-- Left Column: Overview & Contact Info -->
            <div class="sec6-img-col">
                <h2 style="font-size: clamp(2.5rem, 4.5vw, 3.8rem); color: #ffffff; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.1;">
                    REQUEST A<br />
                    COMMERCIAL QUOTE
                </h2>
                
                <p style="font-size: 1.15rem; color: #ffffff; line-height: 1.6; margin-bottom: 2rem; font-weight: 600;">
                    Need a high-performing crew to handle your gym facility move, equipment assembly, or commercial relocation in Southeast Tennessee?
                </p>

                <p style="font-size: 1.05rem; color: #d4d4d8; line-height: 1.6; margin-bottom: 1rem;">
                    Fill out the form with your facility details or call Ben directly at <a href="tel:@BusinessConfig.Value.PhoneNumber" style="color: var(--brand-accent); font-weight: 700; text-decoration: underline;">@BusinessConfig.Value.PhoneNumber</a>.
                </p>
            </div>

            <!-- Right Column: Intake Form matching Squarespace form style -->
            <div class="sec6-form-col">
                @if (isSubmitted)
                {
                    <div style="background: rgba(34, 197, 94, 0.15); border: 2px solid #4ade80; color: #ffffff; padding: 2rem; text-align: center;">
                        <h3 style="color: #4ade80; font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 1rem;">
                            ✓ COMMERCIAL INQUIRY RECEIVED
                        </h3>
                        <p style="font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem;">
                            Thank you, @contactName! Your commercial details were delivered directly to Ben Wiseman. We will review your specs and contact you within 24 hours.
                        </p>
                        <button @onclick="ResetForm" class="sqsp-form-submit-btn">
                            SUBMIT ANOTHER INQUIRY
                        </button>
                    </div>
                }
                else
                {
                    <form @onsubmit="SubmitCommercialLead" @onsubmit:preventDefault>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div style="background: #ef4444; color: #ffffff; padding: 0.75rem 1rem; margin-bottom: 1rem; font-weight: 700;">
                                @errorMessage
                            </div>
                        }

                        <label class="sqsp-form-label">CONTACT NAME *</label>
                        <input type="text" class="sqsp-form-input" @bind="contactName" required placeholder="First & Last Name" />

                        <label class="sqsp-form-label">BUSINESS / FACILITY NAME *</label>
                        <input type="text" class="sqsp-form-input" @bind="businessName" required placeholder="Gym, Facility, or Business Name" />

                        <label class="sqsp-form-label">PHONE NUMBER *</label>
                        <input type="tel" class="sqsp-form-input" @bind="phone" required placeholder="(423) 555-0199" />

                        <label class="sqsp-form-label">EMAIL ADDRESS *</label>
                        <input type="email" class="sqsp-form-input" @bind="email" required placeholder="name@company.com" />

                        <label class="sqsp-form-label">PROJECT TYPE *</label>
                        <select class="sqsp-form-input" @bind="projectType">
                            <option value="Commercial Gym Equipment Assembly">Commercial Gym Equipment Assembly</option>
                            <option value="Gym Relocation & Rigging">Gym Relocation &amp; Rigging</option>
                            <option value="Heavy Equipment Transport">Heavy Equipment Transport</option>
                            <option value="Residential Elite Home Gym Setup">Residential Elite Home Gym Setup</option>
                            <option value="Commercial Office Relocation">Commercial Office Relocation</option>
                        </select>

                        <label class="sqsp-form-label">FACILITY DETAILS &amp; EQUIPMENT LIST *</label>
                        <textarea class="sqsp-form-input" rows="4" @bind="equipmentDetails" required placeholder="List equipment (e.g. 2 Power Cages, 1 Cable Crossover, 4 Treadmills), loading dock / stair access, target dates..."></textarea>

                        <!-- Honeypot -->
                        <div style="display:none;" aria-hidden="true">
                            <input type="text" @bind="botHoneypot" tabindex="-1" autocomplete="off" />
                        </div>

                        <button type="submit" class="sqsp-form-submit-btn" style="width: 100%; margin-top: 1rem;" disabled="@isSubmitting">
                            @(isSubmitting ? "TRANSMITTING..." : "SUBMIT COMMERCIAL INQUIRY")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

