        new("images/gallery/fit-crew-vests.webp", "Forged Labor fitness installation crew in hi-vis vests", "COMMERCIAL INSTALL TEAM", "Dedicated fitness rigging crew inside a newly outfitted performance center.", "center top"),
        new("images/gallery/fit-echo-bikes-prep.webp", "Crew prepping and uncrating Rogue Echo Bikes", "CARDIO & CONDITIONING PREP", "Uncrating, organizing, and assembling fleets of commercial Rogue Echo Bikes."),
        new("images/gallery/fit-echo-bike-build.webp", "Technicians assembling Rogue Echo Bike", "PRECISION CARDIO ASSEMBLY", "Two-person assembly and torque checks on commercial air bikes and ergs."),
        new("images/gallery/fit-uncrating-floor.webp", "Crew uncrating commercial fitness equipment on rubber flooring", "FLOOR-PROTECTED UNCRATING", "Keeping commercial rubber flooring clean and scuff-free during full-facility uncrating."),
        new("images/gallery/fit-facility-staging.webp", "Wide commercial gym staging before rack installation", "FULL-FACILITY STAGING", "Coordinated layout and staging across large commercial gym footprints."),
