@page "/commercial"
@page "/fitness-equipment-installation"
@inject IOptions<BusinessSettings> BusinessConfig
@inject HttpClient Http

<PageTitle>Commercial Fitness Installation | Forged Labor</PageTitle>

<!-- =========================================
     SUBPAGE HERO: CLEAN SOLID BLACK [NO DUPLICATE BACKGROUND IMAGE]
     ========================================= -->
<section class="sec-subpage-header">
    <div class="container-wide">
        <div class="subpage-header-content">
            <h1 class="subpage-heading">
                COMMERCIAL &amp;<br />
                <span class="text-gold">FITNESS EQUIPMENT</span><br />
                INSTALLATION
            </h1>
            <h4 class="subpage-subheading">
                CLEVELAND, CHATTANOOGA &amp; SOUTHEAST TENNESSEE
            </h4>
            <p class="subpage-lead">
                Precision teardown, rigging, transport, and reassembly for commercial gyms, corporate wellness centers, crossfit boxes, and heavy specialty equipment.
            </p>
            <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="#commercial-quote" class="sqsp-btn-pill-yellow">
                    REQUEST COMMERCIAL QUOTE
                </a>
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-outline" style="border-radius: 9999px;">
                    CALL (423) 715-4254
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Continuous Scrolling Marquee (Exact Squarespace Animation) -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
        <span class="marquee-item">COMMERCIAL GYMS - SQUAT RACKS - TREADMILLS - CABLE CROSSOVERS - RIGGING &amp; ASSEMBLY - &nbsp;</span>
    </div>
</div>

<!-- =========================================
     SECTION 2: WHY WE SPECIALIZE [DARK-BOLD #383838 GRAY]
     Columns: LEFT = Truck Pack / Rigging Photo | RIGHT = Copy
     ========================================= -->
<section class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col sec2-mobile-reverse">
            <!-- Left Column: Heavy Equipment Photo -->
            <div class="sec2-img-col">
                <img src="images/local-movers-cleveland-tn.jpg" alt="Commercial Equipment Relocation Cleveland TN" class="sqsp-clean-img" />
            </div>

            <!-- Right Column: Copy -->
            <div class="sec2-text-col">
                <h2 style="font-size: clamp(2.2rem, 3.8vw, 3rem); color: #ffffff; margin-bottom: 1.5rem; text-transform: lowercase;">
                    most movers dread gym gear.
                </h2>
                
                <p style="font-size: 1.25rem; font-weight: 800; color: var(--brand-accent); margin-bottom: 1.25rem; text-transform: uppercase;">
                    WE THRIVE ON IT.
                </p>

                <p style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.65;">
                    Commercial fitness machinery isn't everyday furniture. It has tight tolerances, complex selectorized weight stacks, multi-pulley cable systems, and massive structural weight.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    Because our crew stays consistently conditioned, we understand how gym equipment functions mechanically. We know how to detension cables without fraying, how to bag and label station hardware, and how to protect high-dollar commercial rubber or finished hardwood gym flooring with heavy neoprene runners.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; line-height: 1.65;">
                    When we reassemble your rig or selectorized station, it's square, level, and ready for PRs on day one. <strong>Zero guesswork.</strong>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 3: COMMERCIAL CAPABILITIES [WHITE SECTION]
     Columns: LEFT = Accordion Box | RIGHT = Clean Photo
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <div class="grid-2col sec3-mobile-flow">
            <!-- Left Column: Accordion Capabilities -->
            <div class="sec3-text-col">
                <h2 style="font-size: clamp(2.5rem, 4.5vw, 3.6rem); color: var(--brand-accent); text-transform: uppercase; margin-bottom: 0.35rem; font-family: var(--font-heading); letter-spacing: -0.01em;">
                    FORGED COMMERCIAL
                </h2>
                <h4 style="font-size: 1.15rem; color: #000000; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 2rem; font-family: var(--font-heading); font-weight: 900;">
                    SPECIALIZED RIGGING &amp; INSTALLATION
                </h4>

                <div class="accordion-box">
                    <div class="accordion-item">
                        <div class="accordion-title">
                            COMMERCIAL GYM ASSEMBLY &amp; DISASSEMBLY
                        </div>
                        <p class="accordion-desc">
                            Complete teardown and reassembly of multi-stack cable crossover machines, power racks, functional trainers, Smith machines, and plate-loaded leverage stations.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            HEAVY CARDIO &amp; SPECIALTY TRANSPORT
                        </div>
                        <p class="accordion-desc">
                            Careful handling and moving of commercial treadmills, curved manual runners, stairmasters, assault bikes, rowers, and plate-loaded leg presses utilizing heavy-duty dollies and ramps.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            FACILITY RELOCATIONS &amp; RECONFIGURATIONS
                        </div>
                        <p class="accordion-desc">
                            Expanding your studio, relocating to a larger commercial space, or rearranging your training floor? We provide rapid turnaround with minimal disruption to your members.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            FLOOR PROTECTION &amp; STRUCTURAL ANCHORING
                        </div>
                        <p class="accordion-desc">
                            We lay heavy floor protection runners to safeguard commercial rubber flooring, tile, and hardwood. Precise leveling and concrete anchor bolting where required.
                        </p>
                    </div>
                </div>

                <div style="margin-top: 2rem;">
                    <p style="font-size: 0.95rem; color: #333333; line-height: 1.6; margin: 0;">
                        Full commercial general liability and cargo insurance coverage on every project.
                    </p>
                </div>
            </div>

            <!-- Right Column: Team Photo -->
            <div class="sec3-img-col">
                <img src="images/team.jpg" alt="Forged Labor Commercial Moving Crew" class="sqsp-clean-img" />
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 4: CHEVRON DIVIDER [BLACK THEME]
     ========================================= -->
<section class="sec-move-people">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 6vw, 4.8rem); color: var(--brand-accent); text-transform: uppercase; margin: 0; letter-spacing: -0.02em; font-family: var(--font-heading);">
            BUILT FOR THE HEAVY LIFTS.
        </h2>
    </div>
</section>

<!-- =========================================
     SECTION 5: COMMERCIAL INTAKE FORM [DARK-BOLD #383838 GRAY]
     (Matches Section 6 of Home Page Exactly)
     ========================================= -->
<section id="commercial-quote" class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col">
            <!-- Left Column: Overview & Contact Info -->
            <div class="sec6-img-col">
                <h2 style="font-size: clamp(2.5rem, 4.5vw, 3.8rem); color: #ffffff; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.1;">
                    REQUEST A<br />
                    COMMERCIAL QUOTE
                </h2>
                
                <p style="font-size: 1.15rem; color: #ffffff; line-height: 1.6; margin-bottom: 2rem; font-weight: 600;">
                    Need a high-performing crew to handle your gym facility move, equipment assembly, or commercial relocation in Southeast Tennessee?
                </p>

                <p style="font-size: 1.05rem; color: #d4d4d8; line-height: 1.6; margin-bottom: 1rem;">
                    Fill out the form with your facility details or call Ben directly at <a href="tel:@BusinessConfig.Value.PhoneNumber" style="color: var(--brand-accent); font-weight: 700; text-decoration: underline;">@BusinessConfig.Value.PhoneNumber</a>.
                </p>
            </div>

            <!-- Right Column: Intake Form matching Squarespace form style -->
            <div class="sec6-form-col">
                @if (isSubmitted)
                {
                    <div style="background: rgba(34, 197, 94, 0.15); border: 2px solid #4ade80; color: #ffffff; padding: 2rem; text-align: center;">
                        <h3 style="color: #4ade80; font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 1rem;">
                            ✓ COMMERCIAL INQUIRY RECEIVED
                        </h3>
                        <p style="font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem;">
                            Thank you, @contactName! Your commercial details were delivered directly to Ben Wiseman. We will review your specs and contact you within 24 hours.
                        </p>
                        <button @onclick="ResetForm" class="sqsp-form-submit-btn">
                            SUBMIT ANOTHER INQUIRY
                        </button>
                    </div>
                }
                else
                {
                    <form @onsubmit="SubmitCommercialLead" @onsubmit:preventDefault>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div style="background: #ef4444; color: #ffffff; padding: 0.75rem 1rem; margin-bottom: 1rem; font-weight: 700;">
                                @errorMessage
                            </div>
                        }

                        <label class="sqsp-form-label">CONTACT NAME *</label>
                        <input type="text" class="sqsp-form-input" @bind="contactName" required placeholder="First & Last Name" />

                        <label class="sqsp-form-label">BUSINESS / FACILITY NAME *</label>
                        <input type="text" class="sqsp-form-input" @bind="businessName" required placeholder="Gym, Facility, or Business Name" />

                        <label class="sqsp-form-label">PHONE NUMBER *</label>
                        <input type="tel" class="sqsp-form-input" @bind="phone" required placeholder="(423) 555-0199" />

                        <label class="sqsp-form-label">EMAIL ADDRESS *</label>
                        <input type="email" class="sqsp-form-input" @bind="email" required placeholder="name@company.com" />

                        <label class="sqsp-form-label">PROJECT TYPE *</label>
                        <select class="sqsp-form-input" @bind="projectType">
                            <option value="Commercial Gym Equipment Assembly">Commercial Gym Equipment Assembly</option>
                            <option value="Gym Relocation & Rigging">Gym Relocation &amp; Rigging</option>
                            <option value="Heavy Equipment Transport">Heavy Equipment Transport</option>
                            <option value="Residential Elite Home Gym Setup">Residential Elite Home Gym Setup</option>
                            <option value="Commercial Office Relocation">Commercial Office Relocation</option>
                        </select>

                        <label class="sqsp-form-label">FACILITY DETAILS &amp; EQUIPMENT LIST *</label>
                        <textarea class="sqsp-form-input" rows="4" @bind="equipmentDetails" required placeholder="List equipment (e.g. 2 Power Cages, 1 Cable Crossover, 4 Treadmills), loading dock / stair access, target dates..."></textarea>

                        <!-- Honeypot -->
                        <div style="display:none;" aria-hidden="true">
                            <input type="text" @bind="botHoneypot" tabindex="-1" autocomplete="off" />
                        </div>

                        <button type="submit" class="sqsp-form-submit-btn" style="width: 100%; margin-top: 1rem;" disabled="@isSubmitting">
                            @(isSubmitting ? "TRANSMITTING..." : "SUBMIT COMMERCIAL INQUIRY")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string contactName = string.Empty;
    private string businessName = string.Empty;
    private string phone = string.Empty;
    private string email = string.Empty;
    private string projectType = "Commercial Gym Equipment Assembly";
    private string equipmentDetails = string.Empty;
    private string botHoneypot = string.Empty;

    private bool isSubmitting = false;
    private bool isSubmitted = false;
    private string? errorMessage;

    private async Task SubmitCommercialLead()
    {
        if (!string.IsNullOrEmpty(botHoneypot)) return;

        isSubmitting = true;
        errorMessage = null;

        var fullMessage = $"[Commercial Lead - {businessName}]\nContact: {contactName}\nProject: {projectType}\nDetails:\n{equipmentDetails}";

        var leadRequest = new LeadSubmissionRequest
        {
            BusinessId = "forged-labor",
            CompanyName = "Forged Labor",
            Name = $"{contactName} ({businessName})",
            Phone = phone,
            Email = email,
            PreferredContactMethod = "Phone Call",
            ServiceType = "Commercial & Fitness Equipment Installation",
            Message = fullMessage,
            Honeypot = botHoneypot
        };

        try
        {
            var response = await Http.PostAsJsonAsync("/api/leads", leadRequest);
            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
            }
            else
            {
                errorMessage = "We could not submit your request at this time. Please call (423) 715-4254 directly.";
            }
        }
        catch (Exception)
        {
            errorMessage = "A connection error occurred. Please call (423) 715-4254 directly.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        contactName = string.Empty;
        businessName = string.Empty;
        phone = string.Empty;
        email = string.Empty;
        equipmentDetails = string.Empty;
        botHoneypot = string.Empty;
        isSubmitted = false;
        errorMessage = null;
    }
}
