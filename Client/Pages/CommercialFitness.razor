        new("images/gallery/fitness-weight-room-complete.webp", "Completed commercial weight room installation", "TURNKEY WEIGHT ROOM BUILD", "From crated freight on the dock to a fully bolted, plate-stocked training floor ready for day one."),
        new("images/gallery/fitness-rig-assembly.webp", "Forged Labor crew assembling heavy steel gym uprights", "STRUCTURAL RIG ASSEMBLY", "Team-lifting and positioning heavy-gauge steel uprights inside a collegiate strength & conditioning facility."),
        new("images/gallery/fitness-crossmember-install.webp", "Overhead crossmember and pull-up bar installation", "OVERHEAD CROSSMEMBER RIGGING", "Squaring and torquing high pull-up bars and rack connectors so every bay is rock solid."),
        new("images/gallery/fitness-rack-lineup.webp", "Row of completed custom collegiate power racks", "MULTI-BAY POWER RACK LINEUP", "Custom-branded power racks, integrated platforms, and adjustable benches aligned to the inch."),
        new("images/gallery/fit-collegiate-racks.webp", "Multi-bay collegiate power racks and lifting platforms", "COLLEGIATE STRENGTH FLOOR", "Full row of heavy-duty power racks, bumper plates, and benches installed and leveled."),
        new("images/gallery/fit-fieldhouse-rigs.webp", "Large athletic fieldhouse multi-rig installation", "ATHLETIC FIELDHOUSE BUILD", "Full-scale athletic performance center outfitted with multi-bay racks and turf lanes."),
        new("images/gallery/fit-turf-bolting.webp", "Crew bolting steel rack bases on commercial fieldhouse turf", "PRECISION BASE BOLTING", "Assembling and squaring structural rack bases directly on indoor athletic turf."),
        new("images/gallery/fit-hardhat-rigging.webp", "Hard-hat crew staging heavy rack steel", "JOB-SITE SAFETY & RIGGING", "PPE-equipped crew staging heavy steel beams and hardware on large commercial builds."),
