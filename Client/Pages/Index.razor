@page "/"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<HomePageSettings> HomeConfig
@inject IOptions<ThemeSettings> ThemeConfig

<PageTitle>@BusinessConfig.Value.CompanyName | Moving Company in Cleveland, TN</PageTitle>

<!-- Hero Section -->
<section class="hero-section" style="background: linear-gradient(rgba(18, 18, 20, 0.85), rgba(18, 18, 20, 0.95)), url('images/team.jpg') center/cover no-repeat; padding: 6rem 1.5rem 5rem; border-bottom: 3px solid var(--brand-accent);">
    <div style="max-width: 1100px; margin: 0 auto; text-align: center;">
        <span style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(240, 82, 61, 0.15); border: 1px solid rgba(240, 82, 61, 0.35); color: var(--brand-accent); padding: 0.4rem 1.25rem; border-radius: 9999px; font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.5rem;">
            <span>★</span> Over 100 Five-Star Reviews in Cleveland, TN <span>★</span>
        </span>
        
        <h1 style="font-size: clamp(2.2rem, 5vw, 3.75rem); font-weight: 900; line-height: 1.1; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: -0.01em; color: #ffffff;">
            High-Quality Professional Moving<br />
            <span style="color: var(--brand-accent);">Forged Through Hard Work</span>
        </h1>

        <p style="font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; color: #f4f4f5; max-width: 820px; margin: 0 auto 1.5rem; line-height: 1.4; letter-spacing: 0.04em; text-transform: uppercase;">
            WE SHOW UP. IN SHAPE. ON TIME. READY TO ACCOMPLISH.
        </p>

        <p style="font-size: 1.05rem; color: #a1a1aa; max-width: 760px; margin: 0 auto 2.5rem; line-height: 1.6;">
            When you hire Forged Labor, you're hiring an elite team of physically fit, insured professional movers who treat your home and belongings with dialed-in precision, respect, and zero wasted time.
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/appointments" style="background: var(--brand-accent); color: #ffffff; padding: 1rem 2rem; border-radius: 6px; font-weight: 800; text-decoration: none; font-size: 1.05rem; display: inline-flex; align-items: center; gap: 0.6rem; box-shadow: 0 4px 18px rgba(240, 82, 61, 0.45); transition: transform 0.2s;">
                <span>Schedule a Consultation</span>
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/></svg>
            </a>
            <a href="tel:@BusinessConfig.Value.PhoneNumber" style="background: #27272a; color: #ffffff; padding: 1rem 2rem; border-radius: 6px; font-weight: 700; text-decoration: none; font-size: 1.05rem; border: 1px solid #3f3f46; display: inline-flex; align-items: center; gap: 0.5rem;">
                <svg width="18" height="18" fill="var(--brand-accent)" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/></svg>
                <span>Call @BusinessConfig.Value.PhoneNumber</span>
            </a>
        </div>
    </div>
</section>

<!-- Continuous High-Impact Strip -->
<div style="background: #09090b; border-bottom: 1px solid #27272a; padding: 1rem 1.5rem; overflow: hidden; text-align: center;">
    <div style="font-weight: 800; font-size: 0.95rem; color: #d4d4d8; letter-spacing: 0.12em; text-transform: uppercase;">
        PACKING & UNPACKING &nbsp;•&nbsp; LOCAL & LONG DISTANCE &nbsp;•&nbsp; LOADING & UNLOADING &nbsp;•&nbsp; RESIDENTIAL & COMMERCIAL &nbsp;•&nbsp; FITNESS EQUIPMENT SPECIALISTS
    </div>
</div>

<!-- "Your Stuff Matters" Standard Section -->
<section style="max-width: 1200px; margin: 4rem auto; padding: 0 1.5rem;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
        <div>
            <span style="color: var(--brand-accent); font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">
                The Forged Labor Difference
            </span>
            <h2 style="color: #ffffff; font-size: 2.5rem; font-weight: 900; margin-top: 0; margin-bottom: 1.25rem; text-transform: uppercase; line-height: 1.15;">
                Your Stuff Matters.<br />We Treat It Like Gold.
            </h2>
            <div style="background: #18181b; border-left: 4px solid var(--brand-accent); padding: 1.25rem; border-radius: 0 8px 8px 0; margin-bottom: 1.5rem;">
                <p style="color: #ffffff; font-weight: 700; margin: 0; font-size: 1.05rem; line-height: 1.5;">
                    We don’t ding walls. We don’t scratch floors. We don’t drag furniture. We don’t move at a snail’s pace. We don’t need a break every 10 minutes. We don’t disrespect your time by checking phones constantly.
                </p>
            </div>
            <p style="color: #a1a1aa; line-height: 1.7; font-size: 1rem; margin-bottom: 1.5rem;">
                We show up on time and ready to work hard. We properly protect your belongings with heavy furniture padding, pack the truck neatly to minimize shifting, and carefully unload at your new destination. If needed, we are happy to help with furniture arrangement or assembly.
            </p>
            <p style="color: #a1a1aa; line-height: 1.7; font-size: 1rem; margin-bottom: 2rem;">
                When we’re finished and you’re satisfied, we present your invoice with <strong>no hidden fees or surprise charges</strong>. Whether moving an entire household or a single heavy piece of gym equipment—we get the job done right.
            </p>
            <a href="/appointments" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--brand-accent); color: #ffffff; padding: 0.85rem 1.75rem; border-radius: 6px; font-weight: 700; text-decoration: none;">
                <span>Schedule Your Free Consultation</span>
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/></svg>
            </a>
        </div>

        <div>
            <div style="border-radius: 12px; overflow: hidden; border: 2px solid #27272a; box-shadow: 0 12px 30px rgba(0,0,0,0.4);">
                <img src="images/local-movers-cleveland-tn.jpg" alt="Forged Labor Movers in Cleveland TN" style="width: 100%; height: auto; display: block;" />
            </div>
        </div>
    </div>
</section>

<!-- Core Services Grid -->
<section style="background: #141416; border-top: 1px solid #27272a; border-bottom: 1px solid #27272a; padding: 5rem 1.5rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <div style="text-align: center; max-width: 700px; margin: 0 auto 3.5rem;">
            <span style="color: var(--brand-accent); font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">
                What We Do
            </span>
            <h2 style="color: #ffffff; font-size: 2.4rem; font-weight: 900; margin: 0 0 1rem; text-transform: uppercase;">
                Moving Services In Cleveland, TN
            </h2>
            <p style="color: #a1a1aa; font-size: 1.05rem; margin: 0;">
                Tailored solutions for homeowners, renters, and commercial businesses across Southeast Tennessee.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1.75rem;">
            @foreach (var pillar in HomeConfig.Value.Pillars)
            {
                <div style="background: #1c1c1f; border: 1px solid #2e2e33; border-radius: 10px; padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, border-color 0.2s;">
                    <div>
                        <div style="font-size: 2.25rem; margin-bottom: 1rem;">@pillar.Icon</div>
                        <h3 style="color: #ffffff; font-size: 1.25rem; font-weight: 800; margin: 0 0 0.75rem; text-transform: uppercase;">
                            @pillar.Title
                        </h3>
                        <p style="color: #a1a1aa; font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.5rem;">
                            @pillar.Description
                        </p>
                    </div>
                    <a href="/appointments" style="color: var(--brand-accent); font-weight: 700; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.35rem;">
                        <span>Book This Service →</span>
                    </a>
                </div>
            }
        </div>

        <div style="background: #1c1c1f; border-left: 4px solid var(--brand-accent); border-radius: 6px; padding: 1.25rem 1.5rem; margin-top: 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <p style="margin: 0; color: #d4d4d8; font-size: 0.95rem;">
                <strong>Specialty Heavy-Duty Note:</strong> We specialize in heavy-duty moving including fitness equipment & installations. (Please note: we do <em>not</em> move pianos or hot tubs). Full cargo & liability insurance included.
            </p>
            <a href="tel:@BusinessConfig.Value.PhoneNumber" style="color: var(--brand-accent); font-weight: 700; text-decoration: none; font-size: 0.95rem;">
                Have questions? Call (423) 715-4254
            </a>
        </div>
    </div>
</section>

<!-- Verified 5-Star Reviews & Social Proof -->
<section style="max-width: 1200px; margin: 5rem auto; padding: 0 1.5rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
        <span style="color: var(--brand-accent); font-size: 1.5rem; letter-spacing: 0.2em; display: block; margin-bottom: 0.5rem;">
            ⭐⭐⭐⭐⭐
        </span>
        <h2 style="color: #ffffff; font-size: 2.4rem; font-weight: 900; margin: 0 0 0.5rem; text-transform: uppercase;">
            Over 100 Five-Star Reviews
        </h2>
        <p style="color: #a1a1aa; font-size: 1.05rem; max-width: 650px; margin: 0 auto;">
            Time and time again we prove that FORGED LABOR is the premier option when you need a locally owned and proudly operated moving company in Cleveland, TN.
        </p>
    </div>

    <!-- Review Image Cards from Scrape -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <div style="background: #18181b; border: 1px solid #27272a; border-radius: 10px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.3);">
            <img src="images/cleveland-tn-movers-review1.jpg" alt="Cleveland TN Moving Review 1" style="width: 100%; height: auto; display: block;" />
        </div>
        <div style="background: #18181b; border: 1px solid #27272a; border-radius: 10px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.3);">
            <img src="images/cleveland-tn-movers-review2.jpg" alt="Cleveland TN Moving Review 2" style="width: 100%; height: auto; display: block;" />
        </div>
        <div style="background: #18181b; border: 1px solid #27272a; border-radius: 10px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.3);">
            <img src="images/cleveland-tn-movers-review3.jpg" alt="Cleveland TN Moving Review 3" style="width: 100%; height: auto; display: block;" />
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section style="background: linear-gradient(135deg, #1f1f23 0%, #121214 100%); border-top: 1px solid #27272a; border-bottom: 2px solid var(--brand-accent); padding: 5rem 1.5rem; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
        <h2 style="color: #ffffff; font-size: 2.5rem; font-weight: 900; margin: 0 0 1rem; text-transform: uppercase;">
            Let Us Move You.
        </h2>
        <p style="color: #a1a1aa; font-size: 1.15rem; margin: 0 0 2rem; line-height: 1.6;">
            Whether you are moving across town or need heavy furniture relocated upstairs, Ben and the Forged Labor crew are ready to accomplish the mission.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/appointments" style="background: var(--brand-accent); color: #ffffff; padding: 1rem 2.25rem; border-radius: 6px; font-weight: 800; font-size: 1.05rem; text-decoration: none; box-shadow: 0 4px 18px rgba(240, 82, 61, 0.4);">
                Schedule Consultation Now
            </a>
            <a href="tel:@BusinessConfig.Value.PhoneNumber" style="background: #27272a; color: #ffffff; padding: 1rem 2rem; border-radius: 6px; font-weight: 700; font-size: 1.05rem; text-decoration: none; border: 1px solid #3f3f46;">
                Direct Call: (423) 715-4254
            </a>
        </div>
    </div>
</section>
