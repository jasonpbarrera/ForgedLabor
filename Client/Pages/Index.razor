@page "/"
@inject IOptions<BusinessSettings> BusinessConfig
@inject HttpClient Http

<PageTitle>Forged Labor | Moving Company in Cleveland, TN</PageTitle>

<!-- =========================================
     SECTION 1: HERO [BLACK]
     ========================================= -->
<section class="sec-hero">
    <div class="container-wide" style="max-width: 1050px; margin: 0 auto;">
        <h1 style="font-size: clamp(2.2rem, 5.5vw, 4.2rem); text-transform: uppercase; color: #ffffff; margin-bottom: 2rem; line-height: 1.1;">
            High-quality,<br />
            <span style="color: var(--brand-accent);">PROFESSIONAL MOVING COMPANY</span><br />
            forged through real experience and hard work.
        </h1>

        <h3 style="font-size: clamp(1.2rem, 2.5vw, 1.85rem); color: #ffffff; letter-spacing: 0.06em; margin-bottom: 2.5rem; text-transform: uppercase;">
            WE SHOW UP. &nbsp;IN SHAPE. &nbsp;ON TIME. &nbsp;READY TO ACCOMPLISH.
        </h3>

        <div style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap;">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-primary" style="font-size: 1.05rem; padding: 1rem 2.5rem;">
                CALL NOW
            </a>
            <a href="/appointments" class="sqsp-btn-outline" style="font-size: 1.05rem; padding: 1rem 2.5rem;">
                SCHEDULE A CONSULTATION
            </a>
        </div>
    </div>
</section>

<!-- Continuous Scrolling Marquee (Exact Squarespace Animation) -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
    </div>
</div>

<!-- =========================================
     SECTION 2: YOUR STUFF MATTERS [DARK-BOLD]
     ========================================= -->
<section class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col">
            <div>
                <h2 style="font-size: clamp(2rem, 4vw, 3.25rem); color: #ffffff; margin-bottom: 1.75rem; text-transform: lowercase;">
                    your stuff matters.
                </h2>
                
                <p style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 1.5rem; line-height: 1.7;">
                    We don’t ding walls. We don’t scratch floors. We don’t drag furniture. We don’t move at a snail’s pace. We don’t need a break every 10 minutes. We don’t disrespect your time by checking our phones constantly. We don’t disrespect your belongings by tossing them on a truck without thought.
                </p>

                <p style="font-size: 1rem; color: #d1d5db; margin-bottom: 1.5rem; line-height: 1.7;">
                    When you hire <strong>FORGED LABOR</strong>, you’re hiring a high-performing team of insured professional movers who efficiently handle every part of your move from loading to transport to unloading with dialed-in precision and care.
                </p>

                <p style="font-size: 1rem; color: #d1d5db; margin-bottom: 1.5rem; line-height: 1.7;">
                    We show up on time and ready to work hard. We properly protect your belongings then pack them neatly in the truck to minimize shift - preventing damage during transit. We carefully unload at your new destination, then we’re happy to help with any furniture arrangement or assembly. When we’re finished and you’re satisfied, we’ll present your invoice with no hidden fees or surprise charges.
                </p>

                <p style="font-size: 1rem; color: #d1d5db; line-height: 1.7;">
                    Whether you’re moving the entire family from one home to another or a piece of furniture from one room to another - we’ll help you get the job done, quickly and efficiently. <strong>Every time.</strong>
                </p>
            </div>

            <div>
                <div style="border-radius: 10px; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.5);">
                    <img src="images/team.jpg" alt="Forged Labor Team" style="width: 100%; height: auto; display: block; object-fit: cover;" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 3: FORGED LABOR MOVING SERVICES [WHITE]
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <div class="grid-2col">
            <div>
                <div style="border-radius: 10px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                    <img src="images/local-movers-cleveland-tn.jpg" alt="Local Movers Cleveland TN" style="width: 100%; height: auto; display: block;" />
                </div>
            </div>

            <div>
                <h1 style="font-size: clamp(2rem, 3.8vw, 3rem); color: #000000; margin-bottom: 0.25rem;">
                    forged labor
                </h1>
                <h4 style="font-size: 1.15rem; color: #555555; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2rem;">
                    Moving company in cleveland, tN
                </h4>

                <div class="accordion-item">
                    <div class="accordion-title">
                        <span>FULL SERVICE MOVES</span>
                    </div>
                    <p class="accordion-desc">
                        Includes appropriate moving truck and fuel, 2 strong movers, proper furniture padding and protection, all necessary moving equipment, insurance coverage.
                    </p>
                </div>

                <div class="accordion-item">
                    <div class="accordion-title">
                        <span>LABOR-ONLY MOVERS</span>
                    </div>
                    <p class="accordion-desc">
                        Includes 2 strong movers, proper furniture padding and protection, all necessary moving equipment, insurance coverage.
                    </p>
                </div>

                <div class="accordion-item">
                    <div class="accordion-title">
                        <span>PICKUP &amp; DELIVERY</span>
                    </div>
                    <p class="accordion-desc">
                        Includes appropriate moving truck and fuel, 2 strong movers, pick-up from store, transport, proper placement at new location, insurance coverage. If needed, disassembly and reassembly are also included.
                    </p>
                </div>

                <div style="margin-top: 2rem; padding: 1.25rem; background: #f9f9f9; border-left: 4px solid var(--brand-accent);">
                    <p style="font-size: 0.95rem; color: #333333; margin-bottom: 0.75rem; line-height: 1.6;">
                        We love a good challenge and specialize in heavy-duty moving to include fitness equipment and installation, however <strong>we DO NOT move pianos or hot tubs</strong>.
                    </p>
                    <p style="font-size: 0.95rem; color: #333333; line-height: 1.6; margin: 0;">
                        Insurance coverage includes both liability and cargo. Coverage applies during loading/unloading as well as transport and in the event of an accident.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 4: WE MOVE PEOPLE [BRIGHT-INVERSE]
     ========================================= -->
<section class="sec-bright-inverse">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 6vw, 4.5rem); color: #ffffff; text-transform: uppercase; margin: 0; letter-spacing: 0.02em;">
            we move people.
        </h2>
    </div>
</section>

<!-- =========================================
     SECTION 5: OVER 100 FIVE STAR REVIEWS [BRIGHT]
     ========================================= -->
<section class="sec-bright">
    <div class="container-wide" style="text-align: center;">
        <h4 style="font-size: clamp(1.4rem, 2.5vw, 2rem); color: #000000; text-transform: uppercase; margin-bottom: 1rem;">
            ⭐⭐⭐⭐⭐ OVER 100 FIVE STAR REVIEWS
        </h4>
        <p style="font-size: 1.1rem; color: #444444; max-width: 750px; margin: 0 auto 3rem; line-height: 1.6;">
            Time and time again we prove that <strong>FORGED LABOR</strong> is THE PREMIER option when you need a locally owned and proudly operated moving company in Cleveland, TN.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
            <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <img src="images/cleveland-tn-movers-review1.jpg" alt="Forged Labor Review 1" style="width: 100%; height: auto; display: block;" />
            </div>
            <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <img src="images/cleveland-tn-movers-review2.jpg" alt="Forged Labor Review 2" style="width: 100%; height: auto; display: block;" />
            </div>
            <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <img src="images/cleveland-tn-movers-review3.jpg" alt="Forged Labor Review 3" style="width: 100%; height: auto; display: block;" />
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 6: LET US MOVE YOU + SCHEDULING FORM [DARK-BOLD]
     ========================================= -->
<section class="sec-dark-bold" id="contact-booking">
    <div class="container-wide">
        <div class="grid-2col">
            <div>
                <h2 style="font-size: clamp(2rem, 4vw, 3.25rem); color: #ffffff; margin-bottom: 1rem; text-transform: uppercase;">
                    lET us move you.
                </h2>
                <p style="font-size: 1.1rem; color: #a1a1aa; margin-bottom: 2rem; line-height: 1.6;">
                    Questions? Use the form below to send us an email. We’ll reply as soon as possible and we won’t share your email. Ever.
                </p>

                <div style="border-radius: 10px; overflow: hidden; margin-bottom: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.4);">
                    <img src="images/team.jpg" alt="Forged Labor Team" style="width: 100%; height: auto; display: block;" />
                </div>

                <div style="background: #111111; padding: 1.5rem; border: 1px solid #333333;">
                    <h4 style="font-size: 1.1rem; color: #ffffff; margin-bottom: 0.5rem;">Need an Immediate Consultation?</h4>
                    <p style="color: #a1a1aa; font-size: 0.95rem; margin-bottom: 1rem;">
                        You can also schedule directly on Ben's live calendar:
                    </p>
                    <a href="/appointments" class="sqsp-btn-outline" style="width: 100%; text-align: center; box-sizing: border-box;">
                        Open Appointment Calendar →
                    </a>
                </div>
            </div>

            <!-- Fully Functional Lead & Consultation Form -->
            <div style="background: #181818; padding: 2.5rem; border: 1px solid #333333;">
                <h3 style="color: #ffffff; font-size: 1.5rem; margin-bottom: 1.5rem; text-transform: uppercase;">
                    Send Us An Email / Schedule Move
                </h3>

                @if (isSuccess)
                {
                    <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #4ade80; padding: 1.5rem; margin-bottom: 1.5rem;">
                        <h4 style="margin-bottom: 0.5rem;">✓ Message Sent Successfully!</h4>
                        <p style="margin: 0; font-size: 0.95rem;">Thank you @name! Ben Wiseman will contact you shortly.</p>
                    </div>
                }
                else
                {
                    <form @onsubmit="HandleSubmit">
                        <input type="text" @bind="botHoneypot" style="display:none;" tabindex="-1" autocomplete="off" />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.5); color: #f87171; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.9rem;">
                                @errorMessage
                            </div>
                        }

                        <label class="sqsp-form-label">Name *</label>
                        <input type="text" required @bind="name" placeholder="Your Name" class="sqsp-form-input" />

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div>
                                <label class="sqsp-form-label">Phone *</label>
                                <input type="tel" required @bind="phoneNumber" placeholder="(423) 000-0000" class="sqsp-form-input" />
                            </div>
                            <div>
                                <label class="sqsp-form-label">Email *</label>
                                <input type="email" required @bind="email" placeholder="you@domain.com" class="sqsp-form-input" />
                            </div>
                        </div>

                        <label class="sqsp-form-label">Service Needed</label>
                        <select @bind="selectedService" class="sqsp-form-input" style="height: 48px;">
                            <option value="Full Service Move">Full Service Move (Truck + 2 Movers)</option>
                            <option value="Labor-Only Movers">Labor-Only Movers (Load / Unload)</option>
                            <option value="Store Pickup & Delivery">Pickup & Delivery</option>
                            <option value="Heavy Fitness Equipment">Heavy Duty / Fitness Equipment</option>
                            <option value="Free Consultation">Free 30-Minute Consultation</option>
                        </select>

                        <label class="sqsp-form-label">Preferred Date</label>
                        <input type="date" @bind="preferredStartDate" class="sqsp-form-input" />

                        <label class="sqsp-form-label">Move Details & Questions *</label>
                        <textarea rows="4" required @bind="message" placeholder="Details about home size, stairs, heavy items, or dates..." class="sqsp-form-input" style="resize: vertical;"></textarea>

                        <button type="submit" disabled="@isSubmitting" class="sqsp-btn-primary" style="width: 100%; padding: 1.1rem; font-size: 1rem;">
                            @(isSubmitting ? "SENDING..." : "SUBMIT")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string name = string.Empty;
    private string phoneNumber = string.Empty;
    private string email = string.Empty;
    private string selectedService = "Full Service Move";
    private DateTime? preferredStartDate = null;
    private string message = string.Empty;
    private string botHoneypot = string.Empty;

    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var leadRequest = new LeadSubmissionRequest
        {
            BusinessId = "forged-labor",
            CompanyName = "Forged Labor",
            Name = name,
            Phone = phoneNumber,
            Email = email,
            PreferredContactMethod = "Phone Call",
            ServiceType = selectedService,
            PreferredStartDate = preferredStartDate?.ToString("yyyy-MM-dd"),
            Message = message,
            Honeypot = botHoneypot
        };

        try
        {
            var response = await Http.PostAsJsonAsync("/api/leads", leadRequest);
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = "Unable to submit. Please call 423-715-4254 directly.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect. Please call 423-715-4254 directly.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
