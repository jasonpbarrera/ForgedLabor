@page "/"
@inject IOptions<BusinessSettings> BusinessConfig
@inject HttpClient Http

<PageTitle>Forged Labor | Moving Company in Cleveland, TN</PageTitle>

<!-- =========================================
     SECTION 1: HERO [BLACK THEME]
     ========================================= -->
<section class="sec-hero">
    <div class="container-wide" style="max-width: 1100px; margin: 0 auto;">
        <h1 style="font-size: clamp(2.2rem, 5.5vw, 3.8rem); text-transform: uppercase; color: #ffffff; margin-bottom: 2rem; line-height: 1.15;">
            High-quality,<br />
            <span style="color: var(--brand-accent);">PROFESSIONAL MOVING COMPANY</span><br />
            forged through real experience and hard work.
        </h1>

        <h3 style="font-size: clamp(1.15rem, 2.5vw, 1.7rem); color: #ffffff; letter-spacing: -0.01em; margin-bottom: 2.5rem; text-transform: uppercase;">
            WE SHOW UP. &nbsp;IN SHAPE. &nbsp;ON TIME. &nbsp;READY TO ACCOMPLISH.
        </h3>

        <div style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap;">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-primary" style="font-size: 1rem; padding: 1rem 2.25rem;">
                CALL NOW
            </a>
            <a href="/appointments" class="sqsp-btn-outline" style="font-size: 1rem; padding: 1rem 2.25rem;">
                SCHEDULE A CONSULTATION
            </a>
        </div>
    </div>
</section>

<!-- Continuous Scrolling Marquee (Exact Squarespace Animation) -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
        <span class="marquee-item">PACKING & UNPACKING - LOCAL & LONG DISTANCE - LOADING & UNLOADING - RESIDENTIAL & COMMERCIAL - &nbsp;</span>
    </div>
</div>

<!-- =========================================
     SECTION 2: YOUR STUFF MATTERS [DARK-BOLD #383838 GRAY]
     Columns: LEFT = Team Photo | RIGHT = Text
     ========================================= -->
<section class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col sec2-mobile-reverse">
            <!-- Left Column: Team Photo (Faces at top, not cut off) -->
            <div class="sec2-img-col">
                <img src="images/team.jpg" alt="Forged Labor Team" class="sqsp-clean-img" />
            </div>

            <!-- Right Column: Heading & Paragraphs -->
            <div class="sec2-text-col">
                <h2 style="font-size: clamp(2.2rem, 3.8vw, 3rem); color: #ffffff; margin-bottom: 1.5rem; text-transform: lowercase;">
                    your stuff matters.
                </h2>
                
                <p style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.65;">
                    We don’t ding walls. We don’t scratch floors. We don’t drag furniture. We don’t move at a snail’s pace. We don’t need a break every 10 minutes. We don’t disrespect your time by checking our phones constantly. We don’t disrespect your belongings by tossing them on a truck without thought.
                </p>

                <p style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.6;">
                    When you hire <strong>FORGED LABOR</strong>, you’re hiring a high-performing team of insured professional movers who efficiently handle every part of your move from loading to transport to unloading with dialed-in precision and care.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    We show up on time and ready to work hard. We properly protect your belongings then pack them neatly in the truck to minimize shift - preventing damage during transit. We carefully unload at your new destination, then we’re happy to help with any furniture arrangement or assembly. When we’re finished and you’re satisfied, we’ll present your invoice with no hidden fees or surprise charges.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; line-height: 1.65;">
                    Whether you’re moving the entire family from one home to another or a piece of furniture from one room to another - we’ll help you get the job done, quickly and efficiently. <strong>Every time.</strong>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 3: FORGED LABOR MOVING SERVICES [WHITE]
     Columns: LEFT = Text & Accordions | RIGHT = Moving Truck Photo
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <div class="grid-2col sec3-mobile-flow">
            <!-- Left Column: Services & Accordions -->
            <div class="sec3-text-col">
                <h1 style="font-size: clamp(2.4rem, 4vw, 3.2rem); color: #000000; margin-bottom: 0.25rem;">
                    forged labor
                </h1>
                <h4 style="font-size: 1.15rem; color: #555555; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 2rem;">
                    Moving company in cleveland, tN
                </h4>

                <div class="accordion-item">
                    <div class="accordion-title">
                        FULL SERVICE MOVES
                    </div>
                    <p class="accordion-desc">
                        Includes appropriate moving truck and fuel, 2 strong movers, proper furniture padding and protection, all necessary moving equipment, insurance coverage.
                    </p>
                </div>

                <div class="accordion-item">
                    <div class="accordion-title">
                        LABOR-ONLY MOVERS
                    </div>
                    <p class="accordion-desc">
                        Includes 2 strong movers, proper furniture padding and protection, all necessary moving equipment, insurance coverage.
                    </p>
                </div>

                <div class="accordion-item">
                    <div class="accordion-title">
                        PICKUP &amp; DELIVERY
                    </div>
                    <p class="accordion-desc">
                        Includes appropriate moving truck and fuel, 2 strong movers, pick-up from store, transport, proper placement at new location, insurance coverage. If needed, disassembly and reassembly are also included.
                    </p>
                </div>

                <div style="margin-top: 2rem;">
                    <p style="font-size: 0.95rem; color: #333333; margin-bottom: 0.75rem; line-height: 1.6;">
                        We love a good challenge and specialize in heavy-duty moving to include fitness equipment and installation, however <strong>we DO NOT move pianos or hot tubs</strong>.
                    </p>
                    <p style="font-size: 0.95rem; color: #333333; line-height: 1.6; margin: 0;">
                        Insurance coverage includes both liability and cargo. Coverage applies during loading/unloading as well as transport and in the event of an accident.
                    </p>
                </div>
            </div>

            <!-- Right Column: Local Movers Photo -->
            <div class="sec3-img-col">
                <img src="images/local-movers-cleveland-tn.jpg" alt="Local Movers Cleveland TN" class="sqsp-clean-img" />
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 4: WE MOVE PEOPLE [BRIGHT-INVERSE ORANGE]
     ========================================= -->
<section class="sec-bright-inverse">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 6vw, 4.5rem); color: #ffffff; text-transform: uppercase; margin: 0; letter-spacing: -0.02em;">
            we move people.
        </h2>
    </div>
</section>

<!-- =========================================
     SECTION 5: OVER 100 FIVE STAR REVIEWS [BRIGHT #F4F4F3 GRAY]
     ========================================= -->
<section class="sec-bright">
    <div class="container-wide" style="text-align: center;">
        <h4 style="font-size: clamp(1.4rem, 2.5vw, 2rem); color: #000000; text-transform: uppercase; margin-bottom: 1rem;">
            ⭐⭐⭐⭐⭐ OVER 100 FIVE STAR REVIEWS
        </h4>
        <p style="font-size: 1.1rem; color: #444444; max-width: 750px; margin: 0 auto 3rem; line-height: 1.6;">
            Time and time again we prove that <strong>FORGED LABOR</strong> is THE PREMIER option when you need a locally owned and proudly operated moving company in Cleveland, TN.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
            <div>
                <img src="images/cleveland-tn-movers-review1.jpg" alt="Forged Labor Review 1" class="sqsp-clean-img" />
            </div>
            <div>
                <img src="images/cleveland-tn-movers-review2.jpg" alt="Forged Labor Review 2" class="sqsp-clean-img" />
            </div>
            <div>
                <img src="images/cleveland-tn-movers-review3.jpg" alt="Forged Labor Review 3" class="sqsp-clean-img" />
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 6: LET US MOVE YOU [DARK-BOLD #383838 GRAY]
     Columns: LEFT = Team Photo | RIGHT = Heading + Form
     ========================================= -->
<section class="sec-dark-bold" id="contact-booking">
    <div class="container-wide">
        <div class="grid-2col sec6-mobile-flow">
            <!-- Left Column: Team Photo (Clean flat unbordered image) -->
            <div class="sec6-img-col">
                <img src="images/team.jpg" alt="Forged Labor Team" class="sqsp-clean-img" />
            </div>

            <!-- Right Column: Heading & Contact Form directly on #383838 -->
            <div class="sec6-form-col">
                <h2 style="font-size: clamp(2.2rem, 3.8vw, 3rem); color: #ffffff; margin-bottom: 0.75rem; text-transform: uppercase;">
                    lET us move you.
                </h2>
                <p style="font-size: 1.15rem; color: #e4e4e7; margin-bottom: 2rem; line-height: 1.6;">
                    Questions? Use the form below to send us an email. We’ll reply as soon as possible and we won’t share your email. Ever.
                </p>

                @if (isSuccess)
                {
                    <div style="background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; color: #ffffff; padding: 1.5rem; margin-bottom: 1.5rem;">
                        <h4 style="margin-bottom: 0.5rem; color: #ffffff;">✓ MESSAGE SENT!</h4>
                        <p style="margin: 0; font-size: 0.95rem;">Thank you @name! Ben Wiseman will contact you shortly.</p>
                    </div>
                }
                else
                {
                    <form @onsubmit="HandleSubmit">
                        <input type="text" @bind="botHoneypot" style="display:none;" tabindex="-1" autocomplete="off" />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div style="background: rgba(239, 68, 68, 0.25); border: 1px solid #ef4444; color: #fca5a5; padding: 0.75rem 1rem; margin-bottom: 1.25rem; font-size: 0.9rem;">
                                @errorMessage
                            </div>
                        }

                        <label class="sqsp-form-label">Name *</label>
                        <input type="text" required @bind="name" placeholder="Your Name" class="sqsp-form-input" />

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div>
                                <label class="sqsp-form-label">Phone *</label>
                                <input type="tel" required @bind="phoneNumber" placeholder="(423) 000-0000" class="sqsp-form-input" />
                            </div>
                            <div>
                                <label class="sqsp-form-label">Email *</label>
                                <input type="email" required @bind="email" placeholder="you@domain.com" class="sqsp-form-input" />
                            </div>
                        </div>

                        <label class="sqsp-form-label">Message *</label>
                        <textarea rows="4" required @bind="message" placeholder="Details about your move, timing, or questions..." class="sqsp-form-input" style="resize: vertical;"></textarea>

                        <button type="submit" disabled="@isSubmitting" class="sqsp-form-submit-btn">
                            @(isSubmitting ? "SENDING..." : "SUBMIT")
                        </button>
                    </form>

                    <!-- Direct Appointment Calendar Booking Link -->
                    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.15);">
                        <p style="font-size: 0.95rem; color: #d4d4d8; margin-bottom: 0.75rem;">
                            Need to book a specific date on Ben's calendar right now?
                        </p>
                        <a href="/appointments" class="sqsp-btn-outline" style="display: inline-block; width: 100%; text-align: center;">
                            OPEN LIVE APPOINTMENT SCHEDULER →
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string name = string.Empty;
    private string phoneNumber = string.Empty;
    private string email = string.Empty;
    private string message = string.Empty;
    private string botHoneypot = string.Empty;

    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var leadRequest = new LeadSubmissionRequest
        {
            BusinessId = "forged-labor",
            CompanyName = "Forged Labor",
            Name = name,
            Phone = phoneNumber,
            Email = email,
            PreferredContactMethod = "Email / Phone",
            ServiceType = "Website Inquiry",
            Message = message,
            Honeypot = botHoneypot
        };

        try
        {
            var response = await Http.PostAsJsonAsync("/api/leads", leadRequest);
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = "Unable to submit. Please call 423-715-4254 directly.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect. Please call 423-715-4254 directly.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
