@page "/appointments"
@inject IOptions<BusinessSettings> BusinessConfig
@inject HttpClient Http

<PageTitle>Schedule a Consultation | Forged Labor</PageTitle>

<section class="sec-dark-bold" style="padding: 5rem 2rem 3rem; text-align: center; border-bottom: 2px solid var(--brand-accent);">
    <div class="container-wide" style="max-width: 900px; margin: 0 auto;">
        <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); color: #ffffff; text-transform: uppercase; margin-bottom: 1.25rem;">
            Schedule a Consultation
        </h1>
        <p style="font-size: 1.15rem; color: #d1d5db; line-height: 1.7; margin-bottom: 2rem;">
            A preliminary discussion enables the team to evaluate scope, identify constraints, and propose a tailored relocation blueprint.
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-pill-yellow">
                CALL 423-715-4254
            </a>
            <a href="#booking-form" class="sqsp-btn-outline">
                QUICK INTAKE FORM ↓
            </a>
        </div>
    </div>
</section>

<!-- Direct Acuity / Squarespace Scheduling Embed (Exact 1:1 Experience) -->
<section class="sec-white" style="padding: 4rem 2rem;">
    <div class="container-wide" style="max-width: 1000px; margin: 0 auto;">
        <div style="background: #ffffff; border: 1px solid #e5e7eb; box-shadow: 0 10px 30px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 3.5rem;">
            <div style="padding: 1.5rem 2rem; background: #111111; color: #ffffff; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h3 style="margin: 0; font-size: 1.15rem; color: #ffffff;">Live Calendar Scheduler</h3>
                    <span style="font-size: 0.85rem; color: #a1a1aa;">Select an appointment date and consultation slot directly with Ben Wiseman</span>
                </div>
                <a href="https://blueprintcatalogen.as.me/" target="_blank" rel="noopener" class="sqsp-btn-primary" style="padding: 0.6rem 1.25rem; font-size: 0.8rem;">
                    Full Screen ↗
                </a>
            </div>

            <!-- Embedded Scheduler Iframe -->
            <iframe src="https://blueprintcatalogen.as.me/?template=weekly" 
                    title="Schedule Appointment with Forged Labor" 
                    width="100%" 
                    height="750" 
                    frameBorder="0" 
                    allow="payment" 
                    style="border: 0; width: 100%; min-height: 750px; display: block;"></iframe>
        </div>

        <!-- Fast Fallback Intake & Scheduling Form -->
        <div id="booking-form" style="background: var(--brand-dark-accent); color: #ffffff; padding: 3rem 2.5rem;">
            <h2 style="font-size: 1.85rem; color: #ffffff; margin-bottom: 0.5rem; text-transform: uppercase;">
                Or Request A Consultation Below
            </h2>
            <p style="color: #a1a1aa; font-size: 1rem; margin-bottom: 2rem;">
                Prefer us to reach out to you? Enter your details and Ben will contact you to confirm a time that works best.
            </p>

            @if (isSuccess)
            {
                <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #4ade80; padding: 1.5rem; margin-bottom: 1.5rem;">
                    <h4 style="margin-bottom: 0.5rem;">✓ Request Received!</h4>
                    <p style="margin: 0;">Thanks @name! Ben Wiseman has received your request and will follow up promptly.</p>
                </div>
            }
            else
            {
                <form @onsubmit="HandleSubmit">
                    <input type="text" @bind="botHoneypot" style="display:none;" tabindex="-1" autocomplete="off" />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.5); color: #f87171; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 0.9rem;">
                            @errorMessage
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label class="sqsp-form-label">Full Name *</label>
                            <input type="text" required @bind="name" placeholder="John Smith" class="sqsp-form-input" />
                        </div>
                        <div>
                            <label class="sqsp-form-label">Phone Number *</label>
                            <input type="tel" required @bind="phoneNumber" placeholder="(423) 000-0000" class="sqsp-form-input" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <label class="sqsp-form-label">Email Address *</label>
                            <input type="email" required @bind="email" placeholder="you@domain.com" class="sqsp-form-input" />
                        </div>
                        <div>
                            <label class="sqsp-form-label">Service Type</label>
                            <select @bind="selectedService" class="sqsp-form-input" style="height: 48px;">
                                <option value="Free Consultation">Free 30-Minute Consultation</option>
                                <option value="Full Service Move">Full Service Move (Truck + 2 Movers)</option>
                                <option value="Labor-Only Movers">Labor-Only Movers (Load / Unload)</option>
                                <option value="Pickup & Delivery">Pickup & Delivery</option>
                                <option value="Heavy Fitness Equipment">Heavy Duty / Fitness Equipment</option>
                            </select>
                        </div>
                    </div>

                    <label class="sqsp-form-label">Preferred Date</label>
                    <input type="date" @bind="preferredStartDate" class="sqsp-form-input" />

                    <label class="sqsp-form-label">Move Details & Notes *</label>
                    <textarea rows="4" required @bind="message" placeholder="Details about origin, destination, heavy items, or preferred consultation timing..." class="sqsp-form-input" style="resize: vertical;"></textarea>

                    <button type="submit" disabled="@isSubmitting" class="sqsp-btn-primary" style="padding: 1.1rem 2.5rem; font-size: 1rem;">
                        @(isSubmitting ? "SUBMITTING..." : "REQUEST CONSULTATION")
                    </button>
                </form>
            }
        </div>
    </div>
</section>

@code {
    private string name = string.Empty;
    private string phoneNumber = string.Empty;
    private string email = string.Empty;
    private string selectedService = "Free Consultation";
    private DateTime? preferredStartDate = null;
    private string message = string.Empty;
    private string botHoneypot = string.Empty;

    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var leadRequest = new LeadSubmissionRequest
        {
            BusinessId = "forged-labor",
            CompanyName = "Forged Labor",
            Name = name,
            Phone = phoneNumber,
            Email = email,
            PreferredContactMethod = "Phone Call",
            ServiceType = selectedService,
            PreferredStartDate = preferredStartDate?.ToString("yyyy-MM-dd"),
            Message = message,
            Honeypot = botHoneypot
        };

        try
        {
            var response = await Http.PostAsJsonAsync("/api/leads", leadRequest);
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = "Unable to submit. Please call (423) 715-4254 directly.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect. Please call (423) 715-4254 directly.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
