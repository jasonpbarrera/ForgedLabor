@page "/about"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<AboutPageSettings> AboutConfig

<PageTitle>About Ben, Bre &amp; The Crew | Forged Labor</PageTitle>

<!-- =========================================
     SUBPAGE HERO: CLEAN SOLID BLACK [NO DUPLICATE BACKGROUND IMAGE]
     ========================================= -->
<section class="sec-subpage-header">
    <div class="container-wide">
        <div class="subpage-header-content">
            <h1 class="subpage-heading">
                ABOUT<br />
                FORGED LABOR
            </h1>
            <h4 class="subpage-subheading">
                FOUNDED BY BEN WISEMAN | CLEVELAND, TN
            </h4>
            <p class="subpage-lead">
                Built on discipline, athletic stamina, and honest hard work. We show up on time, in shape, and ready to accomplish every move with dialed-in precision.
            </p>
            <div style="margin-top: 1.5rem;">
                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-pill-yellow">
                    CALL NOW
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Continuous Scrolling Marquee (Exact Squarespace Animation) -->
<div class="marquee-wrapper">
    <div class="marquee-track">
        <span class="marquee-item">FOUNDED BY BEN WISEMAN - CLEVELAND, TN - ATHLETIC CONDITIONING - OVER 100 FIVE STAR REVIEWS - &nbsp;</span>
        <span class="marquee-item">FOUNDED BY BEN WISEMAN - CLEVELAND, TN - ATHLETIC CONDITIONING - OVER 100 FIVE STAR REVIEWS - &nbsp;</span>
        <span class="marquee-item">FOUNDED BY BEN WISEMAN - CLEVELAND, TN - ATHLETIC CONDITIONING - OVER 100 FIVE STAR REVIEWS - &nbsp;</span>
        <span class="marquee-item">FOUNDED BY BEN WISEMAN - CLEVELAND, TN - ATHLETIC CONDITIONING - OVER 100 FIVE STAR REVIEWS - &nbsp;</span>
    </div>
</div>

<!-- =========================================
     SECTION 2: WHY WE STARTED [DARK-BOLD #383838 CHARCOAL GRAY]
     Columns: LEFT = Team Photo | RIGHT = Story
     ========================================= -->
<section class="sec-dark-bold">
    <div class="container-wide">
        <div class="grid-2col sec2-mobile-reverse">
            <!-- Left Column: Team Photo -->
            <div class="sec2-img-col">
                <img src="images/team.jpg" alt="Ben Wiseman and Forged Labor Crew" class="sqsp-clean-img" />
            </div>

            <!-- Right Column: Heading & Paragraphs -->
            <div class="sec2-text-col">
                <h2 style="font-size: clamp(2.2rem, 3.8vw, 3rem); color: #ffffff; margin-bottom: 1.5rem; text-transform: lowercase;">
                    why we started.
                </h2>
                
                <p style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.65;">
                    Too many moving companies send sluggish, careless workers who treat your home like a burden. They take smoke breaks every 15 minutes, stare at their phones, ding walls, and surprise you with hidden fees when the invoice arrives.
                </p>

                <p style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin-bottom: 1.25rem; line-height: 1.6;">
                    When you hire <strong>FORGED LABOR</strong>, you’re hiring people shaped by real-world labor, discipline, and physical excellence. We show up in shape, on time, and ready to hustle.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; margin-bottom: 1.25rem; line-height: 1.65;">
                    Ben Wiseman founded Forged Labor in Cleveland, Tennessee to redefine what a moving company should be. Like steel forged by fire, our work ethic was built through real sweat and life experience. We recruit movers who take personal pride in their stamina, politeness, and property protection.
                </p>

                <p style="font-size: 1rem; color: #e4e4e7; line-height: 1.65;">
                    From the first box loaded to the final piece placed in your new home, our crew maintains focused momentum. <strong>Every single time.</strong>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 3: MEET THE TEAM [WHITE SECTION]
     Columns: LEFT = Team In Accordion Box | RIGHT = Mover Photo
     ========================================= -->
<section class="sec-white">
    <div class="container-wide">
        <div class="grid-2col sec3-mobile-flow">
            <!-- Left Column: Team Profiles -->
            <div class="sec3-text-col">
                <h2 style="font-size: clamp(2.5rem, 4.5vw, 3.6rem); color: var(--brand-accent); text-transform: uppercase; margin-bottom: 0.35rem; font-family: var(--font-heading); letter-spacing: -0.01em;">
                    FORGED LABOR
                </h2>
                <h4 style="font-size: 1.15rem; color: #000000; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 2rem; font-family: var(--font-heading); font-weight: 900;">
                    LEADERSHIP &amp; ON-SITE CREW
                </h4>

                <div class="accordion-box">
                    <div class="accordion-item">
                        <div class="accordion-title">
                            BEN WISEMAN — FOUNDER &amp; LEAD MOVER
                        </div>
                        <p class="accordion-desc">
                            Ben leads from the front line on moves. Shaped by discipline and athletic conditioning, he founded Forged Labor to prove moving can be efficient, respectful, and completely stress-free. Specializing in heavy rigging, safe handling, and master truck loading.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            BRE WISEMAN — OPERATIONS &amp; CLIENT EXPERIENCE
                        </div>
                        <p class="accordion-desc">
                            The organizational backbone behind the scenes. Bre manages arrival windows, customer inquiries, logistics, and scheduling coordination so every move runs seamlessly from start to finish.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            OFFICE COORDINATOR — INTAKE &amp; DISPATCH
                        </div>
                        <p class="accordion-desc">
                            Managing phone lines, fast customer estimates, calendar bookings, and independent reservation requests. Always ready to get you on the schedule with honest, transparent pricing.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            LEAD MOVERS &amp; RIGGING SPECIALISTS
                        </div>
                        <p class="accordion-desc">
                            Senior movers trained in high-value antiques, delicate furniture, commercial fitness equipment assembly, and master truck wall stacking so no cargo shifts during transit.
                        </p>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-title">
                            THE FORGED MOVING CREW
                        </div>
                        <p class="accordion-desc">
                            Background-checked, drug-tested, and physically conditioned movers who hustle. No smoke breaks, no phone staring, and positive energy all day long.
                        </p>
                    </div>
                </div>

                <div style="margin-top: 2rem;">
                    <p style="font-size: 0.95rem; color: #333333; margin-bottom: 0.75rem; line-height: 1.6;">
                        * Individual photos and expanded bios will be added as Ben and the team provide updated headshots!
                    </p>
                </div>
            </div>

            <!-- Right Column: Clean Mover Graphic -->
            <div class="sec3-img-col">
                <img src="images/forged-labor-moving-services.jpg" alt="Forged Labor Movers Cleveland TN" class="sqsp-clean-img" />
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 4: CHEVRON DIVIDER [BLACK THEME]
     ========================================= -->
<section class="sec-move-people">
    <div class="container-wide">
        <h2 style="font-size: clamp(2.5rem, 6vw, 4.8rem); color: var(--brand-accent); text-transform: uppercase; margin: 0; letter-spacing: -0.02em; font-family: var(--font-heading);">
            WE MOVE PEOPLE.
        </h2>
    </div>
</section>

<!-- =========================================
     SECTION 5: VERIFIED BADGES & REVIEWS [TENNESSEE GOLD #EFB600]
     ========================================= -->
<section class="sec-gold-reviews">
    <div class="container-wide">
        <h2 class="sec-reviews-heading">
            OVER 100 FIVE STAR REVIEWS
        </h2>

        <div class="reviews-grid">
            <!-- Card 1: MovingHelper -->
            <div class="review-card-wrapper">
                <div class="review-stars">★★★★★</div>
                <h4 style="font-family: var(--font-heading); color: #000000; font-size: 1.15rem; margin-bottom: 0.5rem; text-transform: uppercase;">
                    U-HAUL MOVINGHELPER®
                </h4>
                <p class="review-text">
                    Official verified moving partner on U-Haul's MovingHelper platform. 5.0 Star Rating with Safeload® coverage eligibility for local Cleveland and Bradley County loading/unloading.
                </p>
                <div class="review-author" style="margin-top: 1rem;">
                    <a href="https://www.uhaul.com/MovingHelp/Cleveland-TN-37312/1/Forged-Labor/?id=220C1EA5C52A41" target="_blank" rel="noopener" style="color: #000000; font-weight: 900; text-decoration: underline;">
                        VIEW MOVINGHELPER PROFILE →
                    </a>
                </div>
            </div>

            <!-- Card 2: Google Profile -->
            <div class="review-card-wrapper">
                <div class="review-stars">★★★★★</div>
                <h4 style="font-family: var(--font-heading); color: #000000; font-size: 1.15rem; margin-bottom: 0.5rem; text-transform: uppercase;">
                    GOOGLE 5-STAR REVIEWS
                </h4>
                <p class="review-text">
                    Over 100 five-star reviews from local Cleveland, Ooltewah, and Chattanooga homeowners praising our speed, punctuality, and property protection.
                </p>
                <div class="review-author" style="margin-top: 1rem;">
                    <a href="https://maps.app.goo.gl/FkAPVz7Y3y5YTgL2A" target="_blank" rel="noopener" style="color: #000000; font-weight: 900; text-decoration: underline;">
                        READ GOOGLE REVIEWS →
                    </a>
                </div>
            </div>

            <!-- Card 3: Fully Insured -->
            <div class="review-card-wrapper">
                <div class="review-stars">★★★★★</div>
                <h4 style="font-family: var(--font-heading); color: #000000; font-size: 1.15rem; margin-bottom: 0.5rem; text-transform: uppercase;">
                    100% INSURED &amp; BONDED
                </h4>
                <p class="review-text">
                    Full commercial general liability and cargo protection coverage. We treat your home, floors, and furniture with absolute respect.
                </p>
                <div class="review-author" style="margin-top: 1rem;">
                    <strong>Cleveland, TN Headquarters</strong>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================
     SECTION 6: CTA TO BOOK [DARK-BOLD #383838 GRAY]
     ========================================= -->
<section class="sec-dark-bold" style="text-align: center; padding: clamp(4rem, 6vw, 6rem) 0;">
    <div class="container-wide" style="max-width: 800px; margin: 0 auto;">
        <h2 style="font-size: clamp(2.2rem, 4vw, 3.2rem); color: #ffffff; text-transform: uppercase; margin-bottom: 1.25rem;">
            READY TO EXPERIENCE THE <span class="text-gold">FORGED STANDARD?</span>
        </h2>
        <p style="font-size: 1.1rem; color: #d4d4d8; line-height: 1.6; margin-bottom: 2.5rem;">
            Whether you need a full-service moving truck, labor-only loading for your container or POD, or commercial gym equipment installation, we're ready.
        </p>
        <div style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap;">
            <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-pill-yellow">
                CALL BEN NOW (423) 715-4254
            </a>
            <a href="/appointments" class="sqsp-btn-outline" style="border-radius: 9999px;">
                OPEN LIVE SCHEDULER →
            </a>
        </div>
    </div>
</section>
