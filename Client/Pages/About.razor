@page "/about"
@inject IOptions<BusinessSettings> BusinessConfig
@inject IOptions<AboutPageSettings> AboutConfig
@inject IOptions<ThemeSettings> ThemeConfig

<PageTitle>@AboutConfig.Value.NavTitle | @BusinessConfig.Value.ShortName</PageTitle>

<section style="background: linear-gradient(rgba(18, 18, 20, 0.85), rgba(18, 18, 20, 0.95)), url('images/team.jpg') center/cover no-repeat; padding: 5rem 1.5rem; border-bottom: 2px solid var(--brand-accent); text-align: center;">
    <div style="max-width: 900px; margin: 0 auto;">
        <span style="display: inline-block; background: rgba(240, 82, 61, 0.15); color: var(--brand-accent); padding: 0.35rem 1rem; border-radius: 9999px; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem; border: 1px solid rgba(240, 82, 61, 0.3);">
            Meet The Founder & Team
        </span>
        <h1 style="font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 900; color: #ffffff; text-transform: uppercase; margin: 0 0 1rem;">
            @AboutConfig.Value.Heading
        </h1>
        <p style="font-size: 1.2rem; color: #d4d4d8; font-weight: 600; margin: 0 0 1rem;">
            @AboutConfig.Value.Subheading
        </p>
        <p style="font-size: 1.05rem; color: #a1a1aa; max-width: 700px; margin: 0 auto; line-height: 1.6;">
            @AboutConfig.Value.LeadText
        </p>
    </div>
</section>

<div style="max-width: 1100px; margin: 4rem auto; padding: 0 1.5rem;">
    <!-- Story Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center; margin-bottom: 4rem;">
        <div>
            <span style="color: var(--brand-accent); font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.5rem;">
                Why We Built Forged Labor
            </span>
            <h2 style="color: #ffffff; font-size: 2rem; font-weight: 800; text-transform: uppercase; margin: 0 0 1.25rem;">
                @AboutConfig.Value.WhyStartedTitle
            </h2>
            @foreach (var p in AboutConfig.Value.WhyStartedParagraphs)
            {
                <p style="color: #a1a1aa; font-size: 1rem; line-height: 1.7; margin-bottom: 1rem;">
                    @p
                </p>
            }
            <div style="background: #18181b; border-left: 4px solid var(--brand-accent); padding: 1rem 1.25rem; border-radius: 0 6px 6px 0; margin-top: 1.5rem;">
                <p style="color: #f4f4f5; font-weight: 700; margin: 0; font-size: 0.95rem;">
                    "We don't need a break every 10 minutes. We don't disrespect your time by checking phones constantly. When you hire Forged Labor, you get focused professionals from start to finish."
                </p>
            </div>
        </div>

        <div>
            <div style="border-radius: 12px; overflow: hidden; border: 2px solid #27272a; box-shadow: 0 10px 25px rgba(0,0,0,0.3);">
                <img src="images/team.jpg" alt="Forged Labor Team Cleveland TN" style="width: 100%; height: auto; display: block;" />
            </div>
        </div>
    </div>

    <!-- The Forged Standard Grid -->
    <div style="background: #18181b; border: 1px solid #27272a; border-radius: 12px; padding: 3rem 2rem; margin-bottom: 4rem;">
        <div style="text-align: center; max-width: 650px; margin: 0 auto 2.5rem;">
            <h2 style="color: #ffffff; font-size: 1.85rem; font-weight: 800; text-transform: uppercase; margin: 0 0 0.5rem;">
                @AboutConfig.Value.WhoIAmTitle
            </h2>
            <p style="color: #a1a1aa; font-size: 0.95rem; margin: 0;">
                Four non-negotiable principles that set our crew apart from typical moving companies.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
            @foreach (var bullet in AboutConfig.Value.WhoIAmBullets)
            {
                var parts = bullet.Split(':', 2);
                <div style="background: #111113; border: 1px solid #27272a; border-radius: 8px; padding: 1.5rem;">
                    <span style="color: var(--brand-accent); font-size: 1.2rem; display: block; margin-bottom: 0.5rem;">⚡</span>
                    @if (parts.Length == 2)
                    {
                        <strong style="color: #ffffff; display: block; font-size: 1rem; margin-bottom: 0.35rem;">@parts[0]</strong>
                        <span style="color: #a1a1aa; font-size: 0.9rem; line-height: 1.5;">@parts[1]</span>
                    }
                    else
                    {
                        <span style="color: #d4d4d8; font-size: 0.95rem;">@bullet</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Call to action card -->
    <div style="background: linear-gradient(135deg, #1c1c1f 0%, #141416 100%); border: 1px solid #27272a; border-radius: 12px; padding: 3rem 2rem; text-align: center;">
        <h3 style="color: #ffffff; font-size: 1.75rem; font-weight: 800; text-transform: uppercase; margin: 0 0 1rem;">
            Ready to Experience the Forged Labor Standard?
        </h3>
        <p style="color: #a1a1aa; font-size: 1rem; max-width: 600px; margin: 0 auto 2rem; line-height: 1.6;">
            @AboutConfig.Value.ClosingText
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/appointments" style="background: var(--brand-accent); color: #ffffff; padding: 0.85rem 2rem; border-radius: 6px; font-weight: 700; text-decoration: none;">
                Schedule a Consultation
            </a>
            <a href="tel:@BusinessConfig.Value.PhoneNumber" style="background: #27272a; color: #ffffff; padding: 0.85rem 2rem; border-radius: 6px; font-weight: 700; text-decoration: none; border: 1px solid #3f3f46;">
                Call (423) 715-4254
            </a>
        </div>
    </div>
</div>
