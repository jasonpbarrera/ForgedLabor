@inherits LayoutComponentBase
@inject IOptions<BusinessSettings> BusinessConfig

<div class="site-wrapper">
    <!-- Squarespace Header -->
    <header class="sqsp-header">
        <div class="sqsp-header-inner">
            <a href="/" class="sqsp-logo-link">
                <img src="images/logo.jpg" alt="Forged Labor" class="sqsp-logo-img" />
            </a>

            <div class="sqsp-header-actions">
                <a href="/appointments" class="sqsp-nav-link" style="margin-right: 0.5rem;">
                    Scheduling
                </a>

                <a href="https://www.facebook.com/Forgedlabor" target="_blank" rel="noopener" aria-label="Facebook" class="sqsp-social-icon">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
                </a>

                <a href="https://www.instagram.com/forgedlabor" target="_blank" rel="noopener" aria-label="Instagram" class="sqsp-social-icon">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>

                <a href="https://maps.app.goo.gl/FkAPVz7Y3y5YTgL2A" target="_blank" rel="noopener" aria-label="Google Maps Location" class="sqsp-social-icon">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                </a>

                <a href="tel:@BusinessConfig.Value.PhoneNumber" class="sqsp-btn-primary">
                    CALL NOW
                </a>
            </div>
        </div>
    </header>

    <main>
        @Body
    </main>

    <!-- Squarespace Section 7: Footer (Location & Map) -->
    <footer class="sec-black-bold">
        <div class="container-wide">
            <div class="footer-grid">
                <!-- Left Column: Logo & Address -->
                <div class="footer-info-col">
                    <div style="margin-bottom: 1.5rem;">
                        <img src="images/logo.jpg" alt="Forged Labor" class="footer-logo-img" />
                    </div>

                    <p style="font-family: var(--font-body); font-size: 1.15rem; line-height: 1.6; margin-bottom: 0.75rem;">
                        <strong>126 Bernham Drive, Suite 4</strong><br />
                        <strong>Cleveland, TN 37312</strong>
                    </p>

                    <p style="font-family: var(--font-body); font-size: 1.15rem; line-height: 1.6; margin-bottom: 1.5rem;">
                        Call <a href="tel:@BusinessConfig.Value.PhoneNumber" style="color: var(--brand-accent); font-weight: 700; text-decoration: underline;">@BusinessConfig.Value.PhoneNumber</a> to schedule your next move.
                    </p>

                    <div class="footer-social-row">
                        <a href="https://www.facebook.com/Forgedlabor" target="_blank" rel="noopener" class="sqsp-social-icon" aria-label="Facebook">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
                        </a>
                        <a href="https://www.instagram.com/forgedlabor" target="_blank" rel="noopener" class="sqsp-social-icon" aria-label="Instagram">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                        <a href="https://maps.app.goo.gl/FkAPVz7Y3y5YTgL2A" target="_blank" rel="noopener" class="sqsp-social-icon" aria-label="Google Maps Location">
                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                        </a>
                    </div>
                </div>

                <!-- Right Column: Embedded Google Map -->
                <div class="footer-map-col">
                    <div class="footer-map-wrapper">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3259.7551307340777!2d-84.8754022120821!3d35.212567885306754!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c57cdc5651611b%3A0xcf2155a126ec792f!2sForged%20Labor!5e0!3m2!1sen!2sus!4v1777345982915!5m2!1sen!2sus"
                            width="100%"
                            height="450"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Forged Labor Google Map Location">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>
